+                        (xstream-encoding xstream)))
+         (detection (getf (xstream-plist xstream) :encoding-detection))
+         (name (xml-header-encoding xml-header))
+         (declared (and name (string-upcase name)))
+         (utf16p (member initial '(:utf-16-big-endian :utf-16-little-endian))))
+    (cond ((null declared)
