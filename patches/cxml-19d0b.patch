+             (wf-error input "UTF-16 requires a matching BOM.")))
+          ((member declared '("UTF-16LE" "UTF-16BE") :test #'string=)
+           (unless (and (eq detection :signature)
+                        (eq initial (if (string= declared "UTF-16LE")
