;; Existing executor guards use excluded resourceData datatypes for Unsupported.
;; Each fault targets one real Case Record in a disposable fresh ASDF process.
(require :asdf)
(assert (string= "2.5.4" (lisp-implementation-version)))
(setf *compile-verbose* nil *load-verbose* nil)
(asdf:load-asd (merge-pathnames "../../topic-maps.asd" *load-truename*))
(asdf:load-system "topic-maps/xtm/tests")
(let* ((family (uiop:getenv "TOPIC_MAPS_21O_FAMILY")) (mode (uiop:getenv "TOPIC_MAPS_21O_FAULT"))
       (target (cond ((string= family "positive") "xtm2/in/empty.xtm")
                     ((string= family "negative") "xtm2/invalid/id-invalid.xtm")
                     ((string= family "name") "xtm2/in/name.xtm")
                     ((string= family "scope") "xtm2/in/name-scope.xtm")
                     ((string= family "iid") "xtm2/in/itemid-name.xtm")
                     ((string= family "variant") "xtm2/in/variant.xtm")
                     ((string= family "variant-negative") "xtm2/invalid/variant-missing-scope-duplicate.xtm")
                     ((string= family "merge-variant") "xtm2/in/merge-itemid-with-variants.xtm")
                     ((string= family "resource-ref") "xtm2/in/variant-resourceref.xtm")
                     ((string= family "resource-ref-relative") "xtm2/in/variant-resourceref-relative.xtm")
                     ((string= family "uri-data") "xtm2/in/variant-resourcedata-uri.xtm")
                     ((string= family "variant-iid") "xtm2/in/itemid-variant.xtm")
                     ((string= family "variant-iid-duplicate") "xtm2/in/variant-duplicate-iid.xtm")
                     ((member family '("map-reifier" "map-reifier-condition") :test #'string=) "xtm2/in/tm-reifier.xtm")
                     ((member family '("name-reifier" "name-reifier-condition") :test #'string=) "xtm2/in/name-reifier.xtm")
                     ((string= family "name-reifier-duplicate") "xtm2/in/name-duplicate-reified.xtm")
                     ((string= family "name-followup2") "xtm2/in/name-duplicate-reified2.xtm")
                     ((string= family "name-followup3") "xtm2/in/name-duplicate-reified3.xtm")
                     ((string= family "name-followup4") "xtm2/in/name-duplicate-reified4.xtm")
                     ((member family '("variant-reifier" "variant-reifier-condition") :test #'string=) "xtm2/in/variant-reifier.xtm")
                     ((string= family "variant-reifier-duplicate") "xtm2/in/variant-duplicate-reifier.xtm")
                     (t (error "Unknown control family ~S" family)))))
  (if (member family '("map-reifier-condition" "name-reifier-condition" "variant-reifier-condition") :test #'string=)
      (let ((saved (symbol-function 'topic-maps.xtm.tests::map-reifier-error-control)))
        (setf (symbol-function 'topic-maps.xtm.tests::map-reifier-error-control)
          (lambda (label source class code &optional thunk map)
            (funcall saved label source class code
              (if (equal label (cond ((string= family "name-reifier-condition") "name:native-reuse-reifier") ((string= family "variant-reifier-condition") "variant:native-reuse-reifier") (t "reuse-reifier")))
                  (lambda ()
                    (let* ((other (topic-maps.tmdm:make-topic-map))
                           (foreign (topic-maps.tmdm:intern-topic other :item-identifier "urn:foreign")))
                      (topic-maps.tmdm:set-item-reifier map foreign)))
                  thunk) map))))
      (if (string= mode "mismatch")
      (let ((saved (symbol-function 'topic-maps.cxtm:canonicalize-octets))
            (iri (concatenate 'string "https://xtm-tests.example.invalid/cd165b150176c1d6842b37be9cc9051b40d4996b/" target)))
        (setf (symbol-function 'topic-maps.cxtm:canonicalize-octets)
          (lambda (map &rest args)
            (let ((actual (apply saved map args)))
              (if (equal iri (getf args :base-locator))
                  (let ((changed (copy-seq actual))) (setf (aref changed 0) (logxor 1 (aref changed 0))) changed)
                  actual)))))
      (let* ((saved (symbol-function 'topic-maps.xtm:deserialize-octets))
             (source (cond ((string= mode "xml") "<a><b></a>")
               ((string= mode "unsupported") (topic-maps.xtm.tests::document "<topic id='a'><name><value>N</value><variant><scope><topicRef href='#s'/></scope><resourceData datatype='http://www.w3.org/2001/XMLSchema#integer'>42</resourceData></variant></name></topic>"))
               ((string= mode "tmdm") (topic-maps.xtm.tests::document
                 (cond ((member family '("name-reifier" "name-reifier-duplicate" "name-followup2" "name-followup3" "name-followup4") :test #'string=)
                   "<topic id='a'><name reifier='#r'><value>A</value></name><name reifier='#r'><value>B</value></name></topic>")
                 ((member family '("variant-reifier" "variant-reifier-duplicate") :test #'string=)
                   "<topic id='a'><name><value>N</value><variant reifier='#r'><scope><topicRef href='#s'/></scope><resourceData>A</resourceData></variant><variant reifier='#r'><scope><topicRef href='#s'/></scope><resourceData>B</resourceData></variant></name></topic>")
                 ((member family '("variant-iid" "variant-iid-duplicate") :test #'string=)
                     "<topic id='a'><name><value>N</value><variant><itemIdentity href='urn:collision'/><scope><topicRef href='#s'/></scope><resourceData>V</resourceData></variant><variant><itemIdentity href='urn:collision'/><scope><topicRef href='#s'/></scope><resourceData>W</resourceData></variant></name></topic>")
                     (t "<itemIdentity href='#a'/><topic id='a'/>"))))
               ((string= mode "xtm") (topic-maps.xtm.tests::document "<topic id='2bad'/>"))
               ((string= mode "wrong-cause") (topic-maps.xtm.tests::document
                 (if (string= family "variant-negative")
                     "<topic id='a'><name><scope><topicRef href='#base'/></scope><value>N</value><variant><scope><topicRef href='#extra'/></scope><resourceData>V</resourceData></variant></name></topic><topic id='base'><itemIdentity href='#extra'/></topic>"
                     "<topic/>")))
               ((string= mode "accepted") (topic-maps.xtm.tests::document "<topic id='valid'/>"))
               (t (error "Unknown control mode ~S" mode)))))
        (setf (symbol-function 'topic-maps.xtm:deserialize-octets)
          (lambda (raw &rest args)
            (if (and (equal target (getf args :source-key)) (string= family "map-reifier") (string= mode "tmdm"))
                ;; Generate an actual native conflict, retaining the previous
                ;; Map-Reification executor control.
                (let* ((map (topic-maps.tmdm:make-topic-map))
                       (r (topic-maps.tmdm:intern-topic map :item-identifier "urn:r"))
                       (owner (topic-maps.tmdm:intern-topic map :item-identifier "urn:owner"))
                       (name (topic-maps.tmdm:add-default-name owner "N")))
                  (topic-maps.tmdm:set-item-reifier map r)
                  (topic-maps.tmdm:set-item-reifier name r))
                (apply saved (if (equal target (getf args :source-key)) (topic-maps.xtm.tests::bytes source) raw) args)))))))
  (asdf:test-system "topic-maps/xtm"))
(error "Fault injection did not cause the required ASDF failure.")
