(in-package #:topic-maps.xtm.tests)
;; Characterization only: use the existing walker/sink without implementing
;; namespace repair, node-set projection, sorting, escaping or C14N ourselves.
(defvar *cq-results* nil)
(defvar *cq-native* nil)
(defvar *cq-api* nil)
(defparameter *cq-known-matches* nil) ; frozen only after outside-repository run
(defun cq-wrap (content &optional (attributes ""))
  (format nil "<xtm:resourceData xmlns:xtm='http://www.topicmaps.org/xtm/' datatype='http://www.w3.org/2001/XMLSchema#anyType'~A>~A</xtm:resourceData>" attributes content))
(defun cq-specs ()
  (list
    (list "simple" (cq-wrap "<x>Hello</x>") "<x>Hello</x>" "XTM 4.16.3; C14N 2.3: element/text, omit container")
    (list "attributes-ba" (cq-wrap "<x b='2' a='1'/>") "<x a=\"1\" b=\"2\"></x>" "C14N 2.3: unqualified attribute order and expanded empty element")
    (list "attributes-ab" (cq-wrap "<x a='1' b='2'></x>") "<x a=\"1\" b=\"2\"></x>" "Same node properties as attributes-ba")
    (list "inherited-prefix" (cq-wrap "<p:x>A</p:x>" " xmlns:p='urn:p' xmlns:u='urn:unused'") "<p:x xmlns:p=\"urn:p\">A</p:x>" "XTM 4.16.3: needed inherited prefix retained; unused mapping removed")
    (list "unused-local-namespace" (cq-wrap "<p:x xmlns:p='urn:p' xmlns:u='urn:unused'>A</p:x>") "<p:x xmlns:p=\"urn:p\">A</p:x>" "XTM 4.16.3: unused namespace absent from selected namespace set")
    (list "inherited-default" (cq-wrap "<x>A</x>" " xmlns='urn:default'") "<x xmlns=\"urn:default\">A</x>" "C14N 2.3-2.4: selected child must retain inherited default namespace")
    (list "nested" (cq-wrap "<x><y b='2' a='1'>Z</y><empty/></x>") "<x><y a=\"1\" b=\"2\">Z</y><empty></empty></x>" "C14N 2.3: nested elements, attributes, empty element")
    (list "escaping" (cq-wrap "<x a='&amp;&lt;&quot;&#x9;&#xA;&#xD;'>A&amp;B&lt;C&gt;&quot;&#x9;&#xA;&#xD;</x>")
      (format nil "<x a=\"&amp;&lt;&quot;&#x9;&#xA;&#xD;\">A&amp;B&lt;C&gt;\"~C~C&#xD;</x>" #\Tab #\Newline)
      "C14N 2.3: attribute vs text escapes, hexadecimal character references")
    (list "whitespace-line-endings" (cq-wrap (format nil "<x> a~C~C b~C c~C~C</x>" #\Return #\Newline #\Return #\Tab #\Newline))
      (format nil "<x> a~% b~% c~C~%</x>" #\Tab) "XML 2.11; C14N 2.1/2.3: normalize CR/CRLF, retain text whitespace")
    (list "comments" (cq-wrap "<x>A<!--excluded-->B</x>") "<x>AB</x>" "XTM 4.16.3: comments=false")
    (list "lexical-cdata" (cq-wrap "<x a='&#65;'><y/><![CDATA[a&b]]></x>") "<x a=\"A\"><y></y>a&amp;b</x>" "C14N 2.1/2.3: references, CDATA and tag spelling have equal selected values")
    (list "lexical-escaped" (cq-wrap "<x a=\"A\"><y></y>a&amp;b</x>") "<x a=\"A\"><y></y>a&amp;b</x>" "Same selected node properties as lexical-cdata")
    (list "unicode" (cq-wrap "<x>Grüße 水 🦊</x>") "<x>Grüße 水 🦊</x>" "C14N 2.1: strict UTF-8 output for scalar character data")
    (list "processing-instruction" (cq-wrap "<x>A<?p excluded?>B</x>") "<x>AB</x>" "XTM selects element/attribute/character nodes, not PI nodes")
    (list "namespace-attribute-order" (cq-wrap "<x xmlns:z='urn:a' xmlns:a='urn:z' z:b='1' a:a='2' plain='0'/>")
      "<x xmlns:a=\"urn:z\" xmlns:z=\"urn:a\" plain=\"0\" z:b=\"1\" a:a=\"2\"></x>"
      "C14N 2.3: namespace nodes before attributes, attributes by namespace URI/local name")
    (list "redundant-binding" (cq-wrap "<p:x xmlns:p='urn:p'><p:y xmlns:p='urn:p'/></p:x>")
      "<p:x xmlns:p=\"urn:p\"><p:y></p:y></p:x>" "C14N 2.3: suppress already rendered identical namespace binding")))
(defun cq-condition (c)
  (when c (mm-fields "class" (string (type-of c)) "detail" (princ-to-string c))))
(defun cq-write (path value)
  (with-open-file (s path :direction :output :if-exists :supersede :if-does-not-exist :create)
    (topic-maps.test-foundation::emit-json-value value s) (terpri s)))
(defun cq-native-probe (id value)
  (let* ((map (make-topic-map)) (owner (intern-topic map :item-identifier "urn:cq:owner"))
         (type (intern-topic map :subject-identifier "urn:cq:type"))
         (name-type (intern-topic map :subject-identifier "urn:cq:name-type"))
         (base (intern-topic map :subject-identifier "urn:cq:base"))
         (theme (intern-topic map :subject-identifier "urn:cq:extra"))
         (name (add-name owner "N" :type name-type :scope (list base)))
         (count (length (topic-map-topics map)))
         (datatype "http://www.w3.org/2001/XMLSchema#anyType")
         (o (add-occurrence owner type value :datatype datatype :scope (list theme)))
         (v (add-variant name value :datatype datatype :scope (list base theme)))
         (before (ik-state map))
         (a (topic-maps.cxtm:canonicalize-octets map :base-locator "urn:cq:base-map"))
         (b (topic-maps.cxtm:canonicalize-octets map :base-locator "urn:cq:base-map")))
    (check (format nil "c14n-native:~A:occurrence-value-datatype-parent-EQ" id)
      (and (equal value (occurrence-value o)) (equal datatype (occurrence-datatype o))
        (eq owner (occurrence-parent o)) (eq type (occurrence-type o)) (eq o (canonical-occurrence o))))
    (check (format nil "c14n-native:~A:variant-value-datatype-parent-EQ" id)
      (and (equal value (variant-value v)) (equal datatype (variant-datatype v))
        (eq name (variant-parent v)) (eq v (canonical-variant v))))
    (check (format nil "c14n-native:~A:scopes-and-no-topics-from-XML" id)
      (and (= count (length (topic-map-topics map))) (scope-eq-p (list theme) (occurrence-scope o))
        (scope-eq-p (list base theme) (variant-scope v))))
    (check (format nil "c14n-native:~A:repeated-CXTM-preserves-all-properties" id)
      (and (equalp a b) (equal before (ik-state map)) (equal value (occurrence-value o)) (equal value (variant-value v))))
    (push (mm-fields "id" id "origin" "actual candidate bytes equal the independent oracle for this probe only"
      "readerIntegration" :false "datatype" datatype "occurrenceValue" (occurrence-value o) "variantValue" (variant-value v)
      "topicCountBefore" count "topicCountAfter" (length (topic-map-topics map))
      "canonicalParentTypeScopeEQ" :true "repeatedCXTMIdentical" :true "modelUnchanged" :true
      "actualCXTM" (babel:octets-to-string a :encoding :utf-8)) *cq-native*)))
(defun cq-probe (spec &optional (encoding :utf-8) bom)
  (destructuring-bind (label source expected rule) spec
    (let* ((id (if (eq encoding :utf-8) label (format nil "~A/~A" label encoding)))
           (raw (bytes source encoding bom)) (copy (copy-seq raw))
           (dom (topic-maps.xml:parse-octets raw (cxml-dom:make-dom-builder)))
           (container (dom:document-element dom))
           ;; Existing DOM child walker, applied experimentally to a container.
           ;; No custom XML serialization/C14N, no namespace repair/filter.
           (actual (dom:map-document (cxml:make-octet-vector-sink :canonical t) container :include-xmlns-attributes t))
           (second-form (dom:map-document (cxml:make-octet-vector-sink :canonical 2) container :include-xmlns-attributes t))
           (whole (dom:map-document (cxml:make-octet-vector-sink :canonical t) dom :include-xmlns-attributes t))
           (want (bytes expected)) (match (equalp actual want))
           (string (babel:octets-to-string actual :encoding :utf-8 :errorp t)))
      (check (format nil "c14n-probe:~A:input-bytes-unchanged" id) (equalp raw copy))
      (check (format nil "c14n-probe:~A:UTF8-string-roundtrip" id) (equalp actual (bytes string)))
      (when *cq-known-matches*
        (check (format nil "c14n-characterization:~A:observed-match-or-limit" id)
          (eq match (not (null (member label *cq-known-matches* :test #'equal))))))
      (push (mm-fields "id" id "inputXML" source "inputEncoding" (string encoding)
        "inputHex" (format nil "~{~2,'0X~}" (coerce raw 'list))
        "API" "topic-maps.xml:parse-octets / cxml-dom:make-dom-builder; dom:map-document canonical sink on container child nodes"
        "candidateOption" "cxml:make-octet-vector-sink :canonical T"
        "subsetAPIQualified" :false "expectedXML" expected "expectedHex" (format nil "~{~2,'0X~}" (coerce want 'list))
        "normativeReason" rule "actualXML" string "actualHex" (format nil "~{~2,'0X~}" (coerce actual 'list))
        "expectedBytes" (length want) "actualBytes" (length actual) "firstDifferentByte" (mismatch want actual)
        "normativeComparison" (if match "PASS-for-this-probe" "BYTE-DIFFERENCE")
        "W3C-C14N-1.0-qualified" :false "secondCanonicalFormXML" (babel:octets-to-string second-form :encoding :utf-8)
        "secondCanonicalFormMatches" (if (equalp second-form want) :true :false)
        "wholeDocumentCanonicalXML" (babel:octets-to-string whole :encoding :utf-8) "condition" nil) *cq-results*)
      (when match (cq-native-probe id string)))))
(defun cq-tests ()
  (setf *cq-results* nil *cq-native* nil *cq-api* nil)
  (dolist (spec (cq-specs)) (cq-probe spec))
  (dolist (encoding '(:utf-16le :utf-16be))
    (let* ((spec (copy-list (find "unicode" (cq-specs) :key #'first :test #'equal))))
      (setf (second spec) (concatenate 'string "<?xml version='1.0' encoding='UTF-16'?>" (second spec)))
      (cq-probe spec encoding t)))
  (dolist (pair (list
    (list "sink-has-no-node-set-keyword" (lambda () (cxml:make-octet-vector-sink :canonical t :node-set nil)))
    (list "walker-has-no-node-set-keyword" (lambda ()
      (let ((doc (topic-maps.xml:parse-octets (bytes "<x/>") (cxml-dom:make-dom-builder))))
        (dom:map-document (cxml:make-octet-vector-sink :canonical t) doc :node-set nil))))))
    (let ((c (condition-from (second pair))))
      (check (concatenate 'string "c14n-api:" (first pair)) (typep c 'program-error))
      (push (mm-fields "id" (first pair) "condition" (cq-condition c)) *cq-api*)))
  (setf *cq-results* (nreverse *cq-results*) *cq-native* (nreverse *cq-native*) *cq-api* (nreverse *cq-api*))
  (let ((path (uiop:getenv "TOPIC_MAPS_C14N_REPORT")))
    (when path (cq-write path (mm-fields "kind" "slice-22q-existing-candidate-characterization-not-reader-support"
      "W3CC14NQualified" :false "XTMReaderIntegration" :false "ownC14NImplementation" :false
      "probes" (coerce *cq-results* 'vector) "nativeValues" (coerce *cq-native* 'vector)
      "APILimits" (coerce *cq-api* 'vector) "checks" (coerce (reverse *checks*) 'vector)))))
  t)
