(require :asdf)
(assert (string= "2.5.4" (lisp-implementation-version)))
(setf *compile-verbose* nil *load-verbose* nil)
(asdf:load-asd #P"/Users/rgb/workspace/topic-maps/topic-maps.asd")
(asdf:load-system "topic-maps/xtm/tests")
(in-package :topic-maps.xtm.tests)
(let* ((map (read-body "<topic id='a'><name><value>N</value><variant><scope><topicRef href='#s'/></scope><resourceData>V</resourceData></variant></name></topic>"))
       (name (first (topic-names (by-id map "a")))) (old (first (all-variants map)))
       (one (add-item-identifier old "urn:v1"))
       (two (add-variant name "V" :scope (variant-scope old))))
  (assert (eq old one))
  (assert (eq two (canonical-variant old)))
  (assert (equal '("urn:v1") (item-identifiers two)))
  (assert (eq two (add-item-identifier two "urn:v1")))
  (assert (eq two (add-item-identifier two "urn:v2")))
  (assert (same-identifiers-p '("urn:v1" "urn:v2") (item-identifiers old)))
  (let* ((other (add-variant name "W" :scope (variant-scope two))) (before (variant-state map))
         (c (condition-from (lambda () (add-item-identifier other "urn:v1")))))
    (assert (eq 'item-identifier-error (type-of c)))
    (assert (eq :duplicate-item-identifier (item-identifier-error-code c)))
    (assert (equal before (variant-state map)))
    (assert (eq two (canonical-variant old)))
    (assert (topic-maps.tmdm::validate-map-item-identifiers map)))
  (format t "VARIANT-II-API-PREFLIGHT-PASS: identifier union, same-II idempotence, canonical handles, distinct-Variant conflict atomicity~%"))
