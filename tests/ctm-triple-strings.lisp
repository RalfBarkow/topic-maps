(defpackage #:topic-maps.triple.tests
  (:use #:cl #:topic-maps.tmdm)
  (:import-from #:topic-maps.registered-original.tests
    #:check #:fields #:binary #:case-state #:identity-fields #:captured-read #:condition-data)
  (:export #:run-tests #:write-reports))
(in-package #:topic-maps.triple.tests)
(defparameter *doc* "https://example.invalid/triple/main.ctm")
(defvar *checks* nil)
(defvar *positives* nil)
(defvar *negatives* nil)
(defvar *original-rows* nil)
(defvar *entry-statuses* nil)
(defun canonical (map) (topic-maps.cxtm:canonicalize-octets map :base-locator *doc*))
(defun quoted (value)
  (with-output-to-string (out)
    (write-char #\" out)
    (loop for c across value do
      (case c
        (#\" (write-string "\\\"" out)) (#\\ (write-string "\\\\" out))
        (#\Newline (write-string "\\n" out)) (#\Return (write-string "\\r" out)) (#\Tab (write-string "\\t" out))
        (otherwise (write-char c out))))
    (write-char #\" out)))
(defun source-for (context literal)
  (ecase context
    (:occurrence (format nil "topic occtype: ~A." literal))
    (:name (format nil "topic - ~A." literal))
    (:variant (format nil "topic - \"Name\" (~A @s)." literal))))
(defun value-in (context map)
  (let ((owner (topic-maps.registered-original.tests::local map *doc* "topic")))
    (ecase context
      (:occurrence (let ((items (topic-occurrences owner)))
        (and (= 1 (length items)) (eq owner (occurrence-parent (first items)))
             (equal (string-datatype) (occurrence-datatype (first items))) (occurrence-value (first items)))))
      (:name (let ((names (topic-names owner)))
        (and (= 1 (length names)) (eq owner (topic-name-parent (first names))) (topic-name-value (first names)))))
      (:variant (let* ((name (first (topic-names owner))) (items (topic-name-variants name)) (v (first items)))
        (and (= 1 (length items)) (eq name (variant-parent v)) (equal (string-datatype) (variant-datatype v))
             (equal (list (topic-maps.registered-original.tests::local map *doc* "s")) (variant-scope v))
             (variant-value v)))))))
(defun accepted (label text)
  (multiple-value-bind (map counter)
      (topic-maps.ctm:deserialize-string text :document-iri *doc* :source-name label :wildcard-counter 37)
    (let* ((held (topic-maps.import.tests::handles map))
           (before (topic-maps.import.tests::state map held)) (actual (canonical map)))
      (check (concatenate 'string label ":model-counter-and-pure-canonicalization")
        (and (= 37 counter) (topic-maps.reference.tests::references-current-p map)
             (equal before (topic-maps.import.tests::state map held)) (equalp actual (canonical map))))
      (push (fields "label" label "sourceText" text "initialCounter" 37 "finalCounter" counter
                    "actualCXTM" (topic-maps.ctm::decode-utf8 actual) "model" (topic-maps.template.tests::observe map)) *positives*))
    map))
