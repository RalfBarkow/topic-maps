;; Construct CR explicitly; source-file line-ending normalization must not
;; change these input streams. Build fresh rows rather than mutate constants.
(setf *negative-specs*
  (mapcar (lambda (spec)
            (let ((text (cond ((equal "quoted-error-CR" (first spec))
                               (format nil "topic.~Cother - \"\\q\"." #\Return))
                              ((equal "quoted-error-CRLF" (first spec))
                               (format nil "topic.~C~Cother - \"\\q\"." #\Return #\Newline))
                              ((equal "triple-unclosed-after-CRLF" (first spec))
                               (format nil "topic.~C~Cother - \"\"\"bad" #\Return #\Newline)))))
              (if text (list* (first spec) text (cddr spec)) spec)))
          *negative-specs*))
(defun negative-controls ()
  (dolist (spec *negative-specs*)
    (destructuring-bind (label text class code position line column) spec
      (multiple-value-bind (map condition)
          (captured-read (lambda () (topic-maps.ctm:deserialize-string text :document-iri *doc* :source-name label)))
        (check (concatenate 'string "negative:" label ":class-code-position-source")
          (and (null map) condition (eq class (type-of condition))
               (eq code (topic-maps.ctm:error-code condition)) (= position (topic-maps.ctm:error-position condition))
               (= line (topic-maps.ctm:error-line condition)) (= column (topic-maps.ctm:error-column condition))
               (eq :character (topic-maps.ctm:error-position-unit condition)) (equal label (topic-maps.ctm:error-source condition))
               (null (topic-maps.ctm:error-cause condition)) (null (topic-maps.ctm:error-context condition))))
        (push (fields "label" label "sourceText" text "condition" (condition-data condition)) *negatives*)))))
(defparameter *originals*
  (list
    (list "occurrence-string-triple" :occurrences "Occurrence \" Value" 41 367)
    (list "occurrence-string-triple2" :occurrences "Occurrence\"\" \" Value\"" 48 370)
    (list "unicode-escape-u4-triple-string" :escapes (format nil "ZZ ~%Top") 33 331)
    (list "unicode-escape-u6-triple-string" :escapes (format nil "ZZ ~%Top") 37 331)))
(defun original-contracts ()
  (let* ((corpus topic-maps.ctm.tests::*cxtm-corpus*) (root (topic-maps.test-foundation:corpus-root corpus))
         (cases (topic-maps.test-foundation:corpus-cases corpus))
         (previous (mapcar (lambda (c) (cons c (case-state c))) cases))
         (ids (mapcar (lambda (spec) (format nil "ctm/in/~A.ctm" (first spec))) *originals*))
         (old-results (copy-tree topic-maps.ctm.tests::*cxtm-results*)) (new-results nil))
    (setf *entry-statuses* (copy-list (getf (topic-maps.test-foundation:summarize-corpus corpus) :statuses)))
    (dolist (spec *originals*)
      (destructuring-bind (name group value source-size expected-size) spec
        (let* ((id (format nil "ctm/in/~A.ctm" name))
               (selected (topic-maps.test-foundation:select-cases corpus :id id)) (case (first selected))
               (*doc* (topic-maps.test-foundation:test-case-document-iri case)))
          (check (concatenate 'string id ":existing-positive-NOT-RUN-record-and-identity")
            (and (= 1 (length selected)) (member case cases :test #'eq)
                 (eq :valid (topic-maps.test-foundation:test-case-category case))
                 (eq :cxtm-equal (topic-maps.test-foundation:test-case-expected-outcome case))
                 (eq :not-run (topic-maps.test-foundation:test-case-status case))
                 (null (topic-maps.test-foundation:test-case-actual-outcome case))
                 (equal *doc* (format nil "https://ctm-tests.example.invalid/~A/~A"
                                    (getf (topic-maps.test-foundation:corpus-metadata corpus) :commit) id))
                 (equal (truename (merge-pathnames id root)) (truename (topic-maps.test-foundation:test-case-source-pathname case)))
                 (= source-size (length (binary (topic-maps.test-foundation:test-case-source-pathname case))))))
          (multiple-value-bind (row result) (topic-maps.registered-original.tests::exercise-case case group)
            (push row *original-rows*)
            (check (concatenate 'string id ":actual-original-byte-comparison-PASS")
              (and result (getf result :match) (= expected-size (getf result :bytes))
                   (eq :pass (topic-maps.test-foundation:test-case-status case))))
            (let* ((context (if (eq group :occurrences) :occurrence :name))
                   (plain (source-for context (quoted value))))
              ;; The Unicode originals use zztop as owner; retain that identity.
              (when (eq context :name) (setf plain (concatenate 'string "zztop" (subseq plain 5))))
              (let* ((map (accepted (concatenate 'string id ":ordinary-control") plain))
                     (actual (canonical map)))
                (check (concatenate 'string id ":ordinary-control-same-original-CXTM")
                  (and (= expected-size (length actual))
                       (equalp actual (binary (topic-maps.test-foundation:test-case-expected-baseline case)))
                       (equal (getf result :actual) (topic-maps.ctm::decode-utf8 actual))))))
            (push result new-results))
          (format t "~&TRIPLE-ORIGINAL ~A: PASS; ~D byte-exact CXTM bytes~%" id expected-size))))
    (check "originals:all-prior-case-records-and-observations-preserved"
      (and (eq corpus topic-maps.ctm.tests::*cxtm-corpus*) (equal cases (topic-maps.test-foundation:corpus-cases corpus))
           (equal old-results topic-maps.ctm.tests::*cxtm-results*)
           (every (lambda (entry) (if (member (topic-maps.test-foundation:test-case-id (car entry)) ids :test #'equal)
                                     (equal (first (cdr entry)) (identity-fields (car entry)))
                                     (equal (cdr entry) (case-state (car entry))))) previous)))
    (let ((after (getf (topic-maps.test-foundation:summarize-corpus corpus) :statuses)))
      (check "originals:exactly-four-NOT-RUN-to-PASS-no-other-status-changes"
        (and (= (+ 4 (getf *entry-statuses* :pass)) (getf after :pass))
             (= (- (getf *entry-statuses* :not-run) 4) (getf after :not-run))
             (= (getf *entry-statuses* :fail) (getf after :fail))
             (= (getf *entry-statuses* :unsupported) (getf after :unsupported)))))
    (setf topic-maps.ctm.tests::*cxtm-results* (append old-results (nreverse new-results)))))
(defun run-tests ()
  (unless topic-maps.ctm.tests::*cxtm-corpus*
    (topic-maps.registered-original.tests:run-tests)
    (topic-maps.registered-original.tests:run-negative-tests)
    (topic-maps.prolog.tests:run-tests)
    (topic-maps.registered-original.tests:run-empty2-tests)
    (topic-maps.ctm-integer.tests:run-tests))
  (setf *positives* nil *negatives* nil *original-rows* nil)
  (let ((topic-maps.registered-original.tests::*checks* nil))
    (positive-controls) (token-controls) (qualified-and-template-controls) (negative-controls) (original-contracts)
    (check "triple:unique-check-names"
      (= (length topic-maps.registered-original.tests::*checks*)
         (length (remove-duplicates topic-maps.registered-original.tests::*checks* :test #'equal))))
    (setf *checks* (nreverse topic-maps.registered-original.tests::*checks*)))
  (setf *positives* (nreverse *positives*) *negatives* (nreverse *negatives*) *original-rows* (nreverse *original-rows*))
  (format t "~&TRIPLE-PASS: ~D checks; four originals plus ~D positive and ~D negative controls~%"
          (length *checks*) (length *positives*) (length *negatives*)) t)
(defun write-reports (prefix)
  (with-open-file (out (concatenate 'string prefix ".triple.json") :direction :output :if-exists :supersede)
    (topic-maps.test-foundation::emit-json-value
      (fields "kind" "ctm-triple-string-execution" "passed" (length *checks*) "failed" 0
              "entryStatuses" (topic-maps.test-foundation::counts-object *entry-statuses*)
              "checks" (coerce *checks* 'vector) "positives" (coerce *positives* 'vector)
              "negativeControls" (coerce *negatives* 'vector) "originals" (coerce *original-rows* 'vector)) out) (terpri out))
  (topic-maps.ctm.tests::write-cxtm-report
    (concatenate 'string prefix ".validation.json") (concatenate 'string prefix ".cxtm.json")
    :additional-checks *checks*
    :scope "Slice 20G: four original Triple String contracts using the existing original harness; shared escapes/Unicode, exact original and ordinary-string CXTM, unchanged model/handles and counters. Prior contracts and four known FAILs preserved."))
