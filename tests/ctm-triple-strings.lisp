(defun positive-controls ()
  (dolist (spec *positive-specs*)
    (destructuring-bind (label body value) spec
      ;; Exercise the common String token in all existing value contexts.
      (dolist (context '(:occurrence :name :variant))
        (let* ((key (format nil "~A:~(~A~)" label context))
               (literal (concatenate 'string "\"\"\"" body "\"\"\""))
               (map (accepted key (source-for context literal)))
               (plain (topic-maps.ctm:deserialize-string (source-for context (quoted value)) :document-iri *doc*)))
          (check (concatenate 'string key ":exact-value-and-ordinary-string-equivalence")
            (and (equal value (value-in context map)) (equalp (canonical map) (canonical plain)))))))))
(defun token-controls ()
  (loop for n from 3 to 8 do
    (let* ((source (concatenate 'string "\"\"\"x" (make-string n :initial-element #\") ";tail"))
           (topic-maps.ctm::*source-text* source)
           (lexer (topic-maps.ctm::make-lexer source)) (token (topic-maps.ctm::next-token lexer)))
      (check (format nil "tokens:closing-run-~D-consumes-exactly-three-quotes" n)
        (and (eq :string (topic-maps.ctm::token-kind token)) (equal "x" (topic-maps.ctm::token-value token))
             (= 0 (topic-maps.ctm::token-position token)) (= 7 (topic-maps.ctm::lexer-cursor lexer))
             (equal (subseq source 7) (concatenate 'string (make-string (- n 3) :initial-element #\") ";tail"))))))
  (dolist (text '("\"\"\"\"\"\"" "\"\"" "\"\"\"a\"\"\";next" "\"\"\"a\"\"\"^^<urn:type>"))
    (multiple-value-bind (tokens failure) (topic-maps.registered-original.tests::lexical-evidence text "tokens")
      (check (concatenate 'string "tokens:first-string:" text)
        (and (null failure) (eq :string (caar tokens)) (= 0 (third (first tokens))))))))
(defun qualified-and-template-controls ()
  (dolist (spec '(("\"\"\"001\"\"\"^^<http://www.w3.org/2001/XMLSchema#integer>" "001" "http://www.w3.org/2001/XMLSchema#integer")
                 ("\"\"\"*\"\"\"" "*" "http://www.w3.org/2001/XMLSchema#string")))
    (destructuring-bind (literal value datatype) spec
      (let* ((map (accepted (concatenate 'string "qualified:" literal) (source-for :occurrence literal)))
             (o (first (topic-occurrences (topic-maps.registered-original.tests::local map *doc* "topic")))))
        (check (concatenate 'string "qualified:" literal ":existing-datatype-path")
          (and (equal value (occurrence-value o)) (equal datatype (occurrence-datatype o)))))))
  (dolist (text '("def f($s) topic - $s. end f(\"\"\"Name\"\"\")"
                  "def f() topic - \"\"\"Name\"\"\". end f()"))
    (let ((map (accepted (concatenate 'string "template:" text) text)))
      (check (concatenate 'string "template:" text ":existing-String-token-path")
        (equal "Name" (value-in :name map))))))
