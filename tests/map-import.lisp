(defpackage #:topic-maps.import.tests
  (:use #:cl #:topic-maps.tmdm)
  (:import-from #:topic-maps.ctm.tests #:check #:cxtm #:map-state)
  (:import-from #:topic-maps.variant.tests #:condition-from)
  (:import-from #:topic-maps.identifier.tests #:si #:current)
  (:export #:run-tests #:import-checks #:write-import-report))
(in-package #:topic-maps.import.tests)
(defvar *last-checks* nil)
(defvar *witnesses* nil)
(defvar *rejections* nil)
(defun import-checks () *last-checks*)
(defun handles (map) (copy-list (topic-maps.tmdm::map-information-items map)))
(defun freeze (value)
  (typecase value (string (copy-seq value)) (cons (cons (freeze (car value)) (freeze (cdr value)))) (t value)))
(defun raw (i)
  ;; Raw slots of held replacements as well as live items: public readers alone
  ;; could conceal a modified forwarding link or a noncanonical stored reference.
  (freeze
   (list i (topic-maps.tmdm::%item-identifiers i)
     (when (topic-maps.tmdm::reifiable-p i) (topic-maps.tmdm::%item-reifier i))
     (etypecase i
       (topic-map (list (topic-maps.tmdm::%topic-map-topics i) (topic-maps.tmdm::%topic-map-associations i)))
       (topic (list (topic-maps.tmdm::%topic-parent i) (topic-maps.tmdm::%topic-forward i)
                    (topic-maps.tmdm::%topic-subject-identifiers i) (topic-maps.tmdm::%topic-subject-locators i)
                    (topic-maps.tmdm::%topic-names i) (topic-maps.tmdm::%topic-occurrences i)))
       (topic-name (list (topic-maps.tmdm::%topic-name-parent i) (topic-maps.tmdm::%topic-name-type i)
                         (topic-maps.tmdm::%topic-name-value i) (topic-maps.tmdm::%topic-name-scope i)
                         (topic-maps.tmdm::%topic-name-variants i) (topic-maps.tmdm::%topic-name-forward i)))
       (variant (list (topic-maps.tmdm::%variant-parent i) (topic-maps.tmdm::%variant-value i)
                      (topic-maps.tmdm::%variant-datatype i) (topic-maps.tmdm::%variant-scope i) (topic-maps.tmdm::%variant-forward i)))
       (occurrence (list (topic-maps.tmdm::%occurrence-parent i) (topic-maps.tmdm::%occurrence-type i)
                         (topic-maps.tmdm::%occurrence-value i) (topic-maps.tmdm::%occurrence-datatype i)
                         (topic-maps.tmdm::%occurrence-scope i) (topic-maps.tmdm::%occurrence-forward i)))
       (association (list (topic-maps.tmdm::%association-parent i) (topic-maps.tmdm::%association-type i)
                          (topic-maps.tmdm::%association-scope i) (topic-maps.tmdm::%association-roles i)
                          (topic-maps.tmdm::%association-forward i)))
       (association-role (list (topic-maps.tmdm::%association-role-parent i) (topic-maps.tmdm::%association-role-type i)
                               (topic-maps.tmdm::%association-role-player i) (topic-maps.tmdm::%association-role-forward i)))))))
(defun state (map held) (mapcar #'raw (remove-duplicates (append (handles map) held) :test #'eq)))
(defun valid (map)
  (and (topic-maps.reference.tests::references-current-p map)
       (topic-maps.tmdm::validate-import-map map)))
(defun fixture (tag &key reverse (identity-prefix ""))
  (let* ((map (make-topic-map)) (ids '("owner" "type" "theme" "extra")) (table (make-hash-table :test #'equal)))
    (dolist (id (if reverse (reverse ids) ids))
      (setf (gethash id table) (si map (concatenate 'string identity-prefix id))))
    (let* ((owner (gethash "owner" table)) (type (gethash "type" table))
           (theme (gethash "theme" table)) (extra (gethash "extra" table))
           (name (add-name owner (copy-seq "Name") :type type :scope (list theme)))
           (variant (add-variant name (copy-seq "Variant") :scope (list theme extra)))
           (occ (add-occurrence owner type (copy-seq "+0007") :datatype (integer-datatype) :scope (list theme)))
           (a (make-association map type (if reverse (list (list type theme) (list type owner))
                                            (list (list type owner) (list type theme))) :scope (list theme)))
           (role (find owner (association-roles a) :key #'association-role-player :test #'eq))
           (other (find theme (association-roles a) :key #'association-role-player :test #'eq))
           (items (list map owner name variant occ a role other)))
      (loop for item in items for label in '("map" "owner" "name" "variant" "occurrence" "association" "role" "other-role") do
        (add-item-identifier item (format nil "urn:~A:~A" tag label))
        (when (topic-maps.tmdm::reifiable-p item)
          (set-item-reifier item (si map (format nil "~A:~A:reifier" tag label)))))
      (values map items type theme extra))))
(defun preserve-source (label source held before bytes)
  (check (concatenate 'string label ":source-raw-slots-and-held-handles-unchanged") (equal before (state source held)))
  (check (concatenate 'string label ":source-byte-identical-CXTM") (string= bytes (cxtm source))))
(defun reject-import (label target source class code &key target-handles source-handles)
  (let* ((th (append (handles target) target-handles)) (sh (append (handles source) source-handles)) (tb (state target th)) (sb (state source sh))
         (tx (cxtm target)) (sx (cxtm source)) (c (condition-from (lambda () (import-map-content target source)))))
    (check (concatenate 'string label ":specific-condition")
           (and (typep c class)
                (eq code (typecase c
                           (core-subject-error (core-subject-error-code c))
                           (reification-error (reification-error-code c))
                           (item-identifier-error (item-identifier-error-code c))
                           (variant-error (variant-error-code c))
                           (map-import-error (map-import-error-code c))))))
    (check (concatenate 'string label ":both-graphs-and-all-held-handles-unchanged")
           (and (equal tb (state target th)) (equal sb (state source sh))))
    (check (concatenate 'string label ":both-CXTM-documents-unchanged") (and (string= tx (cxtm target)) (string= sx (cxtm source))))
    (push (topic-maps.test-foundation::fields "label" label "class" (symbol-name (type-of c))
            "code" (symbol-name code) "bothGraphsUnchanged" :true "bothCXTMUnchanged" :true) *rejections*)))
(defun transfer-tests ()
  (multiple-value-bind (source items type theme extra) (fixture "source")
    (let* ((target (make-topic-map)) (held (handles source)) (before (state source held)) (bytes (cxtm source))
           (root-r (si target "target-map-reifier")))
      (add-item-identifier target "urn:target-map") (set-item-reifier target root-r)
      (multiple-value-bind (result resolve) (import-map-content target source)
        (check "transfer:return-values-and-target-map-identity" (and (eq result target) (functionp resolve)))
        (check "transfer:source-map-metadata-excluded-target-map-metadata-retained"
               (and (equal '("urn:target-map") (item-identifiers target)) (eq root-r (item-reifier target))
                    (eq target (topic-reified root-r))
                    (null (topic-reified (funcall resolve (item-reifier source))))))
        (loop for item in (rest held) for i from 1 for new = (funcall resolve item) do
          (check (format nil "transfer:~D:copied-actual-item-identity" i)
                 (and (not (eq item new)) (eq (type-of item) (type-of new))
                      (eq target (topic-maps.tmdm::item-topic-map new))
                      (equal (item-identifiers item) (item-identifiers new))
                      (eq item (current item)) (eq new (current new))))
          (when (topic-maps.tmdm::reifiable-p item)
            (check (format nil "transfer:~D:Reifier-and-Reified-EQ" i)
                   (and (eq (funcall resolve (item-reifier item)) (item-reifier new)) (eq new (topic-reified (item-reifier new)))))))
        (destructuring-bind (m owner name variant occ a role other) items
          (declare (ignore m))
          (let ((n (funcall resolve name)) (v (funcall resolve variant)) (o (funcall resolve occ))
                (as (funcall resolve a)) (r (funcall resolve role)) (p (funcall resolve owner)) (ty (funcall resolve type)))
            (check "transfer:Name-Parent-Type-and-Scope-EQ"
                   (and (eq p (topic-name-parent n)) (eq ty (topic-name-type n))
                        (eq (funcall resolve theme) (first (topic-name-scope n))) (eq n (first (topic-names p)))))
            (check "transfer:Variant-Parent-Scope-and-stored-lexical-value"
                   (and (eq n (variant-parent v)) (string= "Variant" (variant-value v))
                        (topic-maps.tmdm::same-scope-p (list (funcall resolve theme) (funcall resolve extra)) (variant-scope v))))
            (check "transfer:Occurrence-Parent-Type-Value-Datatype-EQ"
                   (and (eq p (occurrence-parent o)) (eq ty (occurrence-type o))
                        (string= "+0007" (occurrence-value o)) (string= (integer-datatype) (occurrence-datatype o))
                        (eq (funcall resolve theme) (first (occurrence-scope o)))))
            (check "transfer:Association-Role-Parent-Type-Player-Scope-EQ"
                   (and (eq target (association-parent as)) (eq ty (association-type as))
                        (eq as (association-role-parent r)) (eq ty (association-role-type r)) (eq p (association-role-player r))
                        (eq (funcall resolve theme) (first (association-scope as)))
                        (member (funcall resolve other) (association-roles as) :test #'eq)
                        (member r (topic-roles-played p) :test #'eq)))
            (check "transfer:no-source-objects-in-target-graph" (and (valid target) (null (intersection held (handles target) :test #'eq))))
            (let ((snapshot (state target (handles target))) (xml (cxtm target)))
              (check "transfer:deterministic-mutation-free-canonicalization"
                     (and (string= xml (cxtm target)) (equal snapshot (state target (handles target)))))
            (push (topic-maps.test-foundation::fields "label" "full-six-kind-transfer" "sourceUnchanged" :true
                    "parentTypePlayerScopeReifierEQ" :true "sourceCXTM" bytes "targetCXTM" (cxtm target)) *witnesses*)
            (preserve-source "transfer" source held before bytes)
            (loop for bad in (list source target root-r nil 42) for index from 1 do
              (let ((c (condition-from (lambda () (funcall resolve bad)))))
                (check (format nil "resolver:not-imported:~D" index)
                       (and (typep c 'map-import-error) (eq :not-imported (map-import-error-code c))))))
            ;; Known imported objects resolve dynamically after later target merges.
            (let* ((later (si target "later")) (merged (merge-topics p later)))
              (check "resolver:later-target-merge-current-canonical-object" (eq merged (funcall resolve owner))))
            ;; Newly copied strings are independent even of mutable source values.
            (setf (char (topic-name-value n) 0) #\X (char (occurrence-value o) 0) #\0 (char (variant-value v) 0) #\X)
            (preserve-source "transfer:mutable-target-strings" source held before bytes))))))
  (let* ((target (make-topic-map)) (source (make-topic-map)))
    (add-item-identifier source "urn:source-only-map") (set-item-reifier source (si source "map-only-reifier"))
    (import-map-content target source)
    (check "transfer:map-only-source-reifier-is-an-ordinary-imported-Topic"
           (and (= 1 (length (topic-map-topics target))) (null (item-identifiers target)) (null (item-reifier target))
                (null (topic-reified (first (topic-map-topics target)))))))
  (let ((target (make-topic-map)) (source (make-topic-map)))
    (import-map-content target source)
    (check "transfer:empty-graphs" (and (null (topic-map-topics target)) (null (topic-map-associations target))))))
(defun identity-tests ()
  (loop for pair in '((:subject-identifier :subject-identifier) (:item-identifier :item-identifier)
                     (:subject-identifier :item-identifier) (:item-identifier :subject-identifier) (:subject-locator :subject-locator))
        for i from 1 do
    (let* ((target (make-topic-map)) (source (make-topic-map)) (a (intern-topic target (first pair) "urn:identity"))
           (b (intern-topic source (second pair) "urn:identity")))
      (multiple-value-bind (map resolve) (import-map-content target source)
        (check (format nil "identity:~D:canonical-object-EQ" i)
               (and (eq target map) (= 1 (length (topic-map-topics map))) (eq (canonical-topic a) (funcall resolve b))
                    (not (eq a (canonical-topic a))) (eq b (canonical-topic b)) (valid map))))))
  (dolist (pair '((:subject-identifier :subject-locator) (:item-identifier :subject-locator)))
    (let* ((target (make-topic-map)) (source (make-topic-map)) (a (intern-topic target (first pair) "urn:identity"))
           (b (intern-topic source (second pair) "urn:identity")))
      (multiple-value-bind (map resolve) (import-map-content target source)
        (check (format nil "identity:distinct-properties:~A" (first pair))
               (and (= 2 (length (topic-map-topics map))) (not (eq a (funcall resolve b))))))))
  (let* ((target (make-topic-map)) (source (make-topic-map))
         (a (intern-topic target :item-identifier "https://example.invalid/a.ctm#same"))
         (b (intern-topic source :item-identifier "https://example.invalid/b.ctm#same")))
    (multiple-value-bind (map resolve) (import-map-content target source)
      (check "identity:local-fragments-with-different-Document-IRIs-remain-distinct"
             (and (= 2 (length (topic-map-topics map))) (not (eq a (funcall resolve b)))))))
  (let* ((target (make-topic-map)) (source (make-topic-map))
         (a (intern-topic target :subject-identifier (concatenate 'string "urn:" (string (code-char #xE9)))))
         (b (intern-topic source :subject-identifier (concatenate 'string "urn:e" (string (code-char #x301))))))
    (multiple-value-bind (map resolve) (import-map-content target source)
      (check "identity:locator-equality-is-not-CXTM-NFC-equality"
             (and (= 2 (length (topic-map-topics map))) (not (eq a (funcall resolve b))))))))
(defun merge-tests ()
  (multiple-value-bind (source sh) (fixture "s")
    (multiple-value-bind (target th) (fixture "t" :reverse t)
      (let ((before (state source sh)) (sx (cxtm source)))
        (multiple-value-bind (map resolve) (import-map-content target source)
          (declare (ignore map))
          (loop for s in (rest sh) for old in (rest th) for i from 1 for new = (funcall resolve s) do
            (check (format nil "merge:~D:all-six-kinds-and-held-target-handles" i)
                   (and (eq new (current old)) (not (eq old new))
                        (= 2 (length (item-identifiers new))) (eq s (current s))))
            (when (topic-maps.tmdm::reifiable-p s)
              (check (format nil "merge:~D:merged-Reifier-Topics-and-inverse-EQ" i)
                     (and (eq (item-reifier new) (canonical-topic (item-reifier old)))
                          (eq (item-reifier new) (funcall resolve (item-reifier s))) (eq new (topic-reified (item-reifier new)))))))
          (check "merge:fixed-point-and-reference-integrity" (valid target))
          (preserve-source "merge" source sh before sx)
          (let ((counts (length (handles target))) (xml (cxtm target)))
            (multiple-value-bind (same resolve2) (import-map-content target source)
              (check "repeat:identifiers-and-structural-equality-justify-no-additional-items"
                     (and (eq target same) (= counts (length (handles same))) (string= xml (cxtm same))))
              (check "repeat:old-and-new-resolvers-follow-replacements"
                     (every (lambda (s) (eq (funcall resolve s) (funcall resolve2 s))) (rest (handles source))))))
          (push (topic-maps.test-foundation::fields "label" "six-kind-merge-and-repeat" "sourceUnchanged" :true
                  "retainedTargetHandlesCanonical" :true "targetCXTM" (cxtm target)) *witnesses*))))))
  ;; One target Topic bridges two distinct source Topics, collapsing parent,
  ;; Type/Player/Scope references, Names, Variants, Occurrences and Roles.
  (let* ((source (make-topic-map)) (target (make-topic-map))
         (a (si source "a")) (b (si source "b")) (type (si source "type")) (theme (si source "theme"))
         (na (add-name a "N" :type type)) (nb (add-name b "N" :type type))
         (va (add-variant na "V" :scope (list theme))) (vb (add-variant nb "V" :scope (list theme)))
         (oa (add-occurrence a type "O")) (ob (add-occurrence b type "O"))
         (as (make-association source type (list (list type a) (list type b)))) (roles (association-roles as))
         (bridge (si target "a")))
    (add-topic-identifier bridge :subject-identifier "urn:b")
    (multiple-value-bind (map resolve) (import-map-content target source)
      (check "many-to-one:Topics-Names-Variants-Occurrences-Roles"
             (every (lambda (pair) (eq (funcall resolve (first pair)) (funcall resolve (second pair))))
                    (list (list a b) (list na nb) (list va vb) (list oa ob) roles)))
      (check "many-to-one:Role-set-cardinality-and-invariants"
             (and (= 1 (length (association-roles (funcall resolve as)))) (valid map)))))
  ;; An equal Name merges its Reifiers, which are themselves the Types and
  ;; Players of further items. This must continue until the model is stable.
  (let* ((target (make-topic-map)) (source (make-topic-map)) (a (si target "owner")) (b (si source "owner"))
         (ty (si target "name-type")) (sy (si source "name-type")) (r (si target "r")) (s (si source "s"))
         (n (add-name a "N" :type ty)) (m (add-name b "N" :type sy))
         (o (add-occurrence r r "O" :scope (list r))) (p (add-occurrence s s "O" :scope (list s)))
         (as (make-association target r (list (list r r)) :scope (list r)))
         (bs (make-association source s (list (list s s)) :scope (list s))))
    (set-item-reifier n r) (set-item-reifier m s)
    (multiple-value-bind (map resolve) (import-map-content target source)
      (check "cascade:Name-Reifiers-become-same-Topic-without-locator-identity"
             (and (eq (canonical-topic r) (funcall resolve s)) (eq (canonical-topic-name n) (funcall resolve m))))
      (check "cascade:subsequent-parent-type-player-scope-and-item-merging"
             (and (eq (canonical-occurrence o) (funcall resolve p)) (eq (canonical-association as) (funcall resolve bs)) (valid map))))))
(defun conflict-tests ()
  ;; Six imported item kinds versus all seven target kinds. Only Topic/Topic
  ;; identifier overlap may establish identity; no non-Topic II merge shortcut.
  (loop for from from 1 to 6 do
    (dotimes (to 7)
      (multiple-value-bind (target ti) (topic-maps.identifier.tests::fixture)
        (multiple-value-bind (source si) (topic-maps.identifier.tests::fixture (make-topic-map) "source-")
          (add-item-identifier (nth from si) "urn:collision") (add-item-identifier (nth to ti) "urn:collision")
          (if (and (= from 1) (= to 1))
              (multiple-value-bind (map resolve) (import-map-content target source)
                (check "collision:Topic-Topic-is-a-merge"
                       (and (eq (current (second ti)) (funcall resolve (second si))) (valid map))))
              (reject-import (format nil "collision:source-~D-target-~D" from to) target source
                             'item-identifier-error :duplicate-item-identifier))))))
  ;; Equal structural items may share an identifier because they are merged.
  (multiple-value-bind (source sh) (topic-maps.identifier.tests::fixture)
    (multiple-value-bind (target th) (topic-maps.identifier.tests::fixture)
      (loop for s in (rest sh) for tpc in (rest th) for i from 1 do
        (add-item-identifier s (format nil "urn:shared:~D" i)) (add-item-identifier tpc (format nil "urn:shared:~D" i)))
      (multiple-value-bind (map resolve) (import-map-content target source)
        (check "collision:equal-structural-items-merge-before-uniqueness-validation"
               (and (valid map) (every (lambda (s old) (eq (funcall resolve s) (current old))) (rest sh) (rest th)))))))
  (let* ((target (make-topic-map)) (source (make-topic-map)) (iri "urn:root-identifier"))
    (add-item-identifier source iri) (add-item-identifier (si target "target") iri)
    (import-map-content target source)
    (check "collision:excluded-source-root-identifiers-do-not-collide" (= 1 (length (topic-map-topics target)))))
  (let* ((target (make-topic-map)) (source (make-topic-map))
         (a (intern-topic target :subject-identifier (first (core-subject-identifiers))))
         (b (intern-topic source :subject-identifier (second (core-subject-identifiers)))))
    (add-item-identifier a "urn:core:bridge") (add-item-identifier b "urn:core:bridge")
    (reject-import "conflict:Core-Subjects" target source 'core-subject-error :core-subject-conflict))
  (let* ((target (make-topic-map)) (source (make-topic-map))
         (a (intern-topic target :subject-identifier (first (core-subject-identifiers))))
         (b (intern-topic target :subject-identifier (second (core-subject-identifiers)))) (bridge (si source "bridge")))
    (add-item-identifier a "urn:a") (add-item-identifier b "urn:b")
    (add-topic-identifier bridge :subject-identifier "urn:a") (add-topic-identifier bridge :subject-identifier "urn:b")
    (reject-import "conflict:transitive-Core-Subjects" target source 'core-subject-error :core-subject-conflict))
  (let* ((target (make-topic-map)) (source (make-topic-map)) (a (si target "owner")) (b (si source "owner"))
         (ty (si target "type")) (sy (si source "type")) (r (si target "r")) (s (si source "r")))
    (set-item-reifier (add-name a "Different" :type ty) r) (set-item-reifier (add-name b "Name" :type sy) s)
    (reject-import "conflict:Reifier-reifies-different-items" target source 'reification-error :reifier-conflict))
  (let* ((target (make-topic-map)) (source (make-topic-map)) (r (si target "r"))
         (s (si source "r")) (owner (si source "owner")))
    (set-item-reifier target r) (set-item-reifier (add-default-name owner "N") s)
    (reject-import "conflict:retained-target-root-Reifier" target source 'reification-error :reifier-conflict))
  (let* ((target (make-topic-map)) (source (make-topic-map)) (a (si source "a")) (b (si source "b"))
         (owner (si source "owner")) (type (si source "type")) (n (add-name owner "N" :type type :scope (list a)))
         (bridge (si target "a")))
    (add-variant n "V" :scope (list a b)) (add-topic-identifier bridge :subject-identifier "urn:b")
    (reject-import "conflict:Variant-scope-collapse" target source 'variant-error :variant-scope-collapse))
  ;; A merge required solely by equal Names can itself discover a Core conflict.
  (let* ((target (make-topic-map)) (source (make-topic-map)) (a (si target "owner")) (b (si source "owner"))
         (ty (si target "type")) (sy (si source "type"))
         (r (intern-topic target :subject-identifier (first (core-subject-identifiers))))
         (s (intern-topic source :subject-identifier (second (core-subject-identifiers)))))
    (set-item-reifier (add-name a "N" :type ty) r) (set-item-reifier (add-name b "N" :type sy) s)
    (reject-import "conflict:Reifier-induced-Core-conflict" target source 'core-subject-error :core-subject-conflict))
  (let ((map (make-topic-map))) (si map "owner")
    (reject-import "conflict:self-import-policy" map map 'map-import-error :same-map)))
(defun reifier-order-test ()
  ;; Reifier Topics precede owners/types in both maps. The reified Names become
  ;; equal after their owner/type Topics merge; this is not a Reifier conflict.
  (let* ((target (make-topic-map)) (source (make-topic-map))
         (r (si target "r")) (s (si source "r"))
         (a (si target "owner")) (b (si source "owner"))
         (ty (si target "type")) (sy (si source "type"))
         (n (add-name a "N" :type ty)) (m (add-name b "N" :type sy)))
    (set-item-reifier n r) (set-item-reifier m s)
    (multiple-value-bind (map resolve) (import-map-content target source)
      (check "order:Reifier-first-does-not-reject-before-equal-items-can-merge"
             (and (eq (canonical-topic r) (funcall resolve s))
                  (eq (canonical-topic-name n) (funcall resolve m)) (valid map))))))
(defun alias-tests ()
  ;; Start with retained handles to all six replaced content kinds.
  (multiple-value-bind (source old type theme) (topic-maps.identifier.tests::fixture)
    (multiple-value-bind (same later type2 theme2) (topic-maps.identifier.tests::fixture source "later-")
      (declare (ignore same))
      (merge-topics type type2) (merge-topics theme theme2) (merge-topics (second old) (second later))
      (let* ((target (make-topic-map)) (held (append old later)) (before (state source held)) (xml (cxtm source)))
        (multiple-value-bind (map resolve) (import-map-content target source)
          (loop for item in (rest old) for i from 1 do
            (check (format nil "resolver:preexisting-source-alias:~D" i)
                   (eq (funcall resolve item) (funcall resolve (current item)))))
          (preserve-source "resolver:preexisting-source-aliases" source held before xml)
          (check "resolver:preexisting-source-aliases-valid-target" (valid map))
          ;; Snapshot members survive later SOURCE forwarding too. New content
          ;; does not become part of an old import through a hidden global list.
          (let* ((original (current (second old))) (target-object (funcall resolve original))
                 (new (si source "new-after-import")) (merged (merge-topics original new))
                 (c (condition-from (lambda () (funcall resolve merged)))))
            (check "resolver:snapshot-member-after-source-merge"
                   (and (eq target-object (funcall resolve original))
                        (typep c 'map-import-error) (eq :not-imported (map-import-error-code c))))))))))
(defun cascade-conflict-test ()
  ;; Reifier-driven merging, without locator equality, can collapse a Variant
  ;; scope. The rejection must happen on the disposable graph, not on originals.
  (let* ((target (make-topic-map)) (source (make-topic-map))
         (owner (si target "owner")) (other (si source "owner"))
         (type (si target "type")) (stype (si source "type"))
         (r (si target "r")) (s (si source "s"))
         (name (add-name owner "merge" :type type)) (sname (add-name other "merge" :type stype))
         (local-s (si target "s")) (vname (add-name owner "variant-parent" :type type :scope (list r))))
    (add-variant vname "V" :scope (list r local-s))
    (set-item-reifier name r) (set-item-reifier sname s)
    (reject-import "conflict:Reifier-induced-transitive-Variant-collapse" target source 'variant-error :variant-scope-collapse)))

(defun boundary-tests ()
  (let* ((source (make-topic-map)) (target (make-topic-map))
         (a (si source "a")) (b (si source "b")) (c (si source "c"))
         (owner (si source "owner")) (type (si source "type"))
         (name (add-name owner "N" :type type :scope (list a b)))
         (variant (add-variant name "V" :scope (list a b c))) (bridge (si target "a"))
         (held (handles source)) (before (state source held)) (xml (cxtm source)))
    (add-topic-identifier bridge :subject-identifier "urn:b")
    (multiple-value-bind (map resolve) (import-map-content target source)
      (let ((n (funcall resolve name)) (v (funcall resolve variant)))
        (check "scope:import-reduces-cardinality-without-violating-Variant-superset"
               (and (= 1 (length (topic-name-scope n))) (= 2 (length (variant-scope v)))
                    (eq (funcall resolve a) (funcall resolve b))
                    (eq (funcall resolve a) (first (topic-name-scope n)))
                    (topic-maps.tmdm::variant-scope-valid-p (variant-scope v) (topic-name-scope n)) (valid map)))
        (preserve-source "scope:valid-cardinality-reduction" source held before xml))))
  ;; Keep stale handles across a rejected transitive Core conflict, including
  ;; raw forward links that canonical public readers would otherwise conceal.
  (let* ((target (make-topic-map)) (source (make-topic-map))
         (a (intern-topic target :subject-identifier (first (core-subject-identifiers))))
         (b (intern-topic target :subject-identifier (second (core-subject-identifiers))))
         (old-target (si target "old-target")) (bridge (si source "bridge")) (old-source (si source "old-source")))
    (merge-topics a old-target) (merge-topics bridge old-source)
    (add-item-identifier a "urn:a") (add-item-identifier b "urn:b")
    (add-topic-identifier bridge :subject-identifier "urn:a") (add-topic-identifier bridge :subject-identifier "urn:b")
    (reject-import "conflict:transitive-with-preexisting-stale-handles" target source 'core-subject-error :core-subject-conflict
                   :target-handles (list a old-target) :source-handles (list bridge old-source)))
  (let* ((target (make-topic-map)) (source (make-topic-map)) (topic (si source "t"))
         (th (handles target)) (sh (handles source)) (tb (state target th)) (sb (state source sh)))
    (loop for args in (list (list nil source) (list target nil) (list topic source) (list target topic)) for i from 1 do
      (let ((condition (condition-from (lambda () (apply #'import-map-content args)))))
        (check (format nil "arguments:~D:TYPE-ERROR-before-either-map-mutation" i)
               (and (typep condition 'type-error) (equal tb (state target th)) (equal sb (state source sh))))))))

(defun order-tests ()
  (let ((outputs nil))
    (dolist (reverse '(nil t))
      (dolist (order '(nil t))
        (let ((target (make-topic-map)))
          (dolist (tag (if order '("b" "a" "c") '("a" "b" "c")))
            (multiple-value-bind (source sh) (fixture tag :reverse reverse)
              (let ((before (state source sh)) (xml (cxtm source)))
                (import-map-content target source)
                (preserve-source (format nil "order:~A:~A:~A" reverse order tag) source sh before xml))))
          (check (format nil "order:~A:~A:fixed-point" reverse order) (valid target))
          (push (cxtm target) outputs))))
    (check "order:construction-and-import-order-byte-identical-CXTM" (every (lambda (x) (string= x (first outputs))) outputs))))
(defun run-tests ()
  (topic-maps.template.tests:run-tests)
  (let ((topic-maps.ctm.tests::*checks* nil))
    (setf *witnesses* nil *rejections* nil)
    (transfer-tests) (identity-tests) (merge-tests) (conflict-tests) (reifier-order-test) (alias-tests) (cascade-conflict-test) (boundary-tests) (order-tests)
    (check "imports:no-promoted-CTM-or-XTM-contracts"
           (equal '(:pass 187 :fail 2 :unsupported 0 :not-run 84)
                  (getf (topic-maps.test-foundation:summarize-corpus topic-maps.ctm.tests::*cxtm-corpus*) :statuses)))
    (setf *last-checks* (nreverse topic-maps.ctm.tests::*checks*) *witnesses* (nreverse *witnesses*) *rejections* (nreverse *rejections*))
    (format t "~&MAP-IMPORT-PASS: ~D checks; no CTM import contracts executed.~%" (length *last-checks*)) t))
(defun write-import-report (path)
  (with-open-file (out path :direction :output :if-exists :supersede :if-does-not-exist :create)
    (topic-maps.test-foundation::emit-json-value
      (topic-maps.test-foundation::fields "kind" "map-content-import-model-evidence" "passed" (length *last-checks*) "failed" 0
        "checks" (topic-maps.test-foundation::json-array *last-checks*)
        "witnesses" (topic-maps.test-foundation::json-array *witnesses*)
        "rejections" (topic-maps.test-foundation::json-array *rejections*)) out)
    (terpri out)))
