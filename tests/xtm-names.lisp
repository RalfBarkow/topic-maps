                  ("variant-reifier-excluded-datatype" "<name><value>N</value><variant reifier='#r'><scope><topicRef href='#v'/></scope><resourceData datatype='http://www.w3.org/2001/XMLSchema#anyType'>42</resourceData></variant></name>" :resource-resolver-required)))
    (name-error-control (concatenate 'string "unsupported-" (first spec))
      (format nil "<topic id='a'>~A</topic>" (second spec)) 'xtm-unsupported (third spec)))
  (let* ((body (format nil "~%<topic id='a'>~% <name/>~%</topic>"))
         (c (condition-from (lambda () (read-body body)))))
    (check "name-syntax:multiline-name-position" (and (eq (type-of c) 'xtm-rejection)
      (eq :missing-name-value (error-code c)) (= 3 (error-line c)) (plusp (error-column c)))))
  (let* ((raw (bytes "<x:topicMap xmlns:x='http://www.topicmaps.org/xtm/' version='2.0'><x:topic id='a'><x:name><x:value>N</x:value></x:name></x:topic></x:topicMap>"))
         (map (deserialize-octets raw :document-iri *document*)))
    (check "name-syntax:qualified-prefix-name" (equal "N" (topic-name-value (first (topic-names (by-id map "a"))))))))

(defun name-tests ()
  (setf *name-controls* nil)
  (name-text-controls) (name-identity-controls) (retained-name-controls) (name-syntax-controls)
  (setf *name-controls* (nreverse *name-controls*)))
