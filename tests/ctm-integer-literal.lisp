occtype: **;." topic-maps.ctm:ctm-rejection :invalid-occurrence-literal 15 2 10)
    ("suffix-name" "topic
occtype: *foo;." topic-maps.ctm:ctm-rejection :invalid-occurrence-literal 15 2 10)
    ("suffix-digit" "topic
occtype: *1;." topic-maps.ctm:ctm-rejection :invalid-occurrence-literal 15 2 10)
    ("suffix-question" "topic
occtype: *?;." topic-maps.ctm:ctm-rejection :invalid-occurrence-literal 15 2 10)
    ("suffix-colon" "topic
occtype: *:;." topic-maps.ctm:ctm-rejection :invalid-occurrence-literal 15 2 10)
    ("signed-plus" "topic
occtype: +*;." topic-maps.ctm:ctm-rejection :invalid-occurrence-literal 15 2 10)
    ("signed-minus" "topic
occtype: -*;." topic-maps.ctm:ctm-rejection :expected-occurrence-value 15 2 10)
    ("date-looking" "topic
occtype: *-1;." topic-maps.ctm:ctm-rejection :invalid-date-year 15 2 10)
