(defun negative-controls ()
  (dolist (spec *negative-specs*)
    (destructuring-bind (label text class code position line column) spec
      (multiple-value-bind (map condition)
          (captured-read (lambda () (topic-maps.ctm:deserialize-string text :document-iri *doc* :source-name label)))
        (check (concatenate 'string "negative:" label ":class-code-exact-position")
          (and (null map) condition (eq class (type-of condition))
               (eq code (topic-maps.ctm:error-code condition))
               (= position (topic-maps.ctm:error-position condition))
               (= line (topic-maps.ctm:error-line condition)) (= column (topic-maps.ctm:error-column condition))
               (eq :character (topic-maps.ctm:error-position-unit condition))
               (equal label (topic-maps.ctm:error-source condition))
               (if (eq class 'topic-maps.ctm:invalid-template-argument)
                   (consp (topic-maps.ctm:error-context condition))
                   (null (topic-maps.ctm:error-context condition)))
               (null (topic-maps.ctm:error-cause condition))))
        (push (fields "label" label "sourceText" text "condition" (condition-data condition)) *negatives*)))))
(defun original-contract ()
  (let* ((corpus topic-maps.ctm.tests::*cxtm-corpus*) (root (topic-maps.test-foundation:corpus-root corpus))
         (id "ctm/in/occurrence-ctm-integer.ctm")
         (selected (topic-maps.test-foundation:select-cases corpus :id id)) (case (first selected))
         (cases (topic-maps.test-foundation:corpus-cases corpus))
         (previous (mapcar (lambda (c) (cons c (case-state c))) cases))
         (old-results (copy-tree topic-maps.ctm.tests::*cxtm-results*))
         (*doc* (topic-maps.test-foundation:test-case-document-iri case)))
    (setf *entry-statuses* (copy-list (getf (topic-maps.test-foundation:summarize-corpus corpus) :statuses)))
    (check "original:existing-positive-NOT-RUN-record-and-pinned-identities"
      (and (= 1 (length selected)) (member case cases :test #'eq)
           (eq :valid (topic-maps.test-foundation:test-case-category case))
           (eq :cxtm-equal (topic-maps.test-foundation:test-case-expected-outcome case))
           (eq :not-run (topic-maps.test-foundation:test-case-status case))
           (null (topic-maps.test-foundation:test-case-actual-outcome case))
           (equal *doc* (format nil "https://ctm-tests.example.invalid/~A/~A"
                              (getf (topic-maps.test-foundation:corpus-metadata corpus) :commit) id))
           (equal (truename (merge-pathnames id root)) (truename (topic-maps.test-foundation:test-case-source-pathname case)))))
    (check "original:unchanged-eighteen-source-bytes"
      (equalp (binary (topic-maps.test-foundation:test-case-source-pathname case))
              (map '(vector (unsigned-byte 8)) #'char-code (format nil "topic~%occtype: *;."))))
    (multiple-value-bind (row result) (topic-maps.registered-original.tests::exercise-case case :occurrences)
      (setf *original* row)
      (check "original:actual-356-byte-original-comparison-PASS"
        (and result (getf result :match) (= 356 (getf result :bytes))
             (eq :pass (topic-maps.test-foundation:test-case-status case))))
      (multiple-value-bind (control counter) (accepted "original:qualified-control" (format nil "topic~%occtype: ~A;." *qualified*))
        (assert-occurrence "original:qualified-control" control "*" *datatype*)
        (check "original:qualified-control-356-byte-baseline-match-and-zero-counter"
          (and (= 0 counter) (= 356 (length (canonical control)))
               (equalp (canonical control) (binary (topic-maps.test-foundation:test-case-expected-baseline case)))
               (equal (getf result :actual) (topic-maps.ctm::decode-utf8 (canonical control))))))
      (check "original:all-prior-case-records-and-observations-preserved"
        (and (eq corpus topic-maps.ctm.tests::*cxtm-corpus*)
             (equal cases (topic-maps.test-foundation:corpus-cases corpus))
             (equal old-results topic-maps.ctm.tests::*cxtm-results*)
             (every (lambda (entry) (if (eq case (car entry))
                                       (equal (first (cdr entry)) (identity-fields case))
                                       (equal (cdr entry) (case-state (car entry))))) previous)))
      (setf topic-maps.ctm.tests::*cxtm-results* (append topic-maps.ctm.tests::*cxtm-results* (list result))))
    (let ((after (getf (topic-maps.test-foundation:summarize-corpus corpus) :statuses)))
      (check "original:exactly-one-NOT-RUN-to-PASS-no-other-status-changes"
        (and (= (1+ (getf *entry-statuses* :pass)) (getf after :pass))
             (= (1- (getf *entry-statuses* :not-run)) (getf after :not-run))
             (= (getf *entry-statuses* :fail) (getf after :fail))
             (= (getf *entry-statuses* :unsupported) (getf after :unsupported)))))
    (format t "~&CTM-INTEGER-ORIGINAL ~A: PASS; 356 byte-exact CXTM bytes~%" id)))
(defun run-tests ()
  (unless topic-maps.ctm.tests::*cxtm-corpus*
    (topic-maps.registered-original.tests:run-tests)
    (topic-maps.registered-original.tests:run-negative-tests)
    (topic-maps.prolog.tests:run-tests)
    (topic-maps.registered-original.tests:run-empty2-tests))
  (setf *positives* nil *negatives* nil *original* nil)
  (let ((topic-maps.registered-original.tests::*checks* nil))
    (positive-controls) (numeric-controls) (variant-controls) (wildcard-controls)
    (template-controls) (token-controls) (negative-controls) (original-contract)
    (check "ctm-integer:unique-check-names"
      (= (length topic-maps.registered-original.tests::*checks*)
         (length (remove-duplicates topic-maps.registered-original.tests::*checks* :test #'equal))))
    (setf *checks* (nreverse topic-maps.registered-original.tests::*checks*)))
  (setf *positives* (nreverse *positives*) *negatives* (nreverse *negatives*))
  (format t "~&CTM-INTEGER-PASS: ~D checks; one original plus ~D positive and ~D negative controls~%"
          (length *checks*) (length *positives*) (length *negatives*)) t)
(defun write-reports (prefix)
  (with-open-file (out (concatenate 'string prefix ".literal.json") :direction :output :if-exists :supersede)
    (topic-maps.test-foundation::emit-json-value
      (fields "kind" "ctm-integer-literal-execution" "passed" (length *checks*) "failed" 0
              "entryStatuses" (topic-maps.test-foundation::counts-object *entry-statuses*)
              "checks" (coerce *checks* 'vector) "positives" (coerce *positives* 'vector)
              "negativeControls" (coerce *negatives* 'vector) "original" *original*) out) (terpri out))
  (topic-maps.ctm.tests::write-cxtm-report
    (concatenate 'string prefix ".validation.json") (concatenate 'string prefix ".cxtm.json")
    :additional-checks *checks*
    :scope "Slice 20F: original CTM '*' literal, lexical value '*' and CTM-integer datatype. Exact original/qualified CXTM, Occurrence/Variant and existing Template literal paths, token diagnostics and unchanged Wildcard counters; previous contracts and four known FAILs preserved."))
