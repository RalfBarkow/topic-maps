(defpackage #:topic-maps.ctm-integer.tests
  (:use #:cl #:topic-maps.tmdm)
  (:import-from #:topic-maps.registered-original.tests
    #:check #:fields #:binary #:case-state #:identity-fields #:captured-read #:condition-data)
  (:export #:run-tests #:write-reports))
(in-package #:topic-maps.ctm-integer.tests)
(defparameter *doc* "https://example.invalid/ctm-integer/main.ctm")
(defparameter *datatype* "http://psi.topicmaps.org/iso13250/ctm-integer")
(defparameter *qualified* "\"*\"^^<http://psi.topicmaps.org/iso13250/ctm-integer>")
(defvar *checks* nil)
(defvar *positives* nil)
(defvar *negatives* nil)
(defvar *original* nil)
(defvar *entry-statuses* nil)
(defun canonical (map) (topic-maps.cxtm:canonicalize-octets map :base-locator *doc*))
(defun occurrences (map)
  (loop for topic in (topic-map-topics map) append (topic-occurrences topic)))
(defun item-value-p (item value datatype)
  (and item (equal value (occurrence-value item)) (equal datatype (occurrence-datatype item))))
(defun accepted (label text &optional (initial-counter 0))
  (multiple-value-bind (map counter)
      (topic-maps.ctm:deserialize-string text :document-iri *doc* :source-name label
                                            :wildcard-counter initial-counter)
    (let* ((held (topic-maps.import.tests::handles map))
           (before (topic-maps.import.tests::state map held))
           (actual (canonical map)))
      (check (concatenate 'string label ":current-model-and-pure-canonicalization")
        (and (topic-maps.reference.tests::references-current-p map)
             (equal before (topic-maps.import.tests::state map held))
             (equalp actual (canonical map))))
      (push (fields "label" label "sourceText" text "initialCounter" initial-counter "finalCounter" counter
                    "model" (topic-maps.template.tests::observe map)
                    "actualCXTM" (topic-maps.ctm::decode-utf8 actual)) *positives*))
    (values map counter)))
(defun assert-occurrence (label map value datatype)
  (let* ((items (occurrences map)) (item (first items))
         (owner (topic-maps.registered-original.tests::local map *doc* "topic"))
         (type (topic-maps.registered-original.tests::local map *doc* "occtype")))
    (check (concatenate 'string label ":occurrence-value-datatype-and-references")
      (and (= 1 (length items)) (item-value-p item value datatype)
           (eq owner (occurrence-parent item)) (eq type (occurrence-type item))
           (= 2 (length (topic-map-topics map))) (null (topic-map-associations map))
           (null (occurrence-scope item)) (null (item-identifiers item))))))
(defun positive-controls ()
  (let* ((bare (accepted "equivalence:bare" (format nil "topic~%occtype: *;.")))
         (qualified (accepted "equivalence:qualified" (format nil "topic~%occtype: ~A;." *qualified*)))
         (string (accepted "distinction:string" (format nil "topic~%occtype: \"*\";."))))
    (assert-occurrence "equivalence:bare" bare "*" *datatype*)
    (assert-occurrence "equivalence:qualified" qualified "*" *datatype*)
    (assert-occurrence "distinction:string" string "*" (string-datatype))
    (check "equivalence:qualified-and-bare-CXTM-equal-string-distinct"
      (and (equalp (canonical bare) (canonical qualified))
           (not (equalp (canonical bare) (canonical string))))))
  (dolist (spec '(("compact" "topic occtype:*.") ("semicolon" "topic occtype:*;.")
                 ("scope" "topic occtype:*@s.") ("reifier" "topic occtype:*~r.")
                 ("comment" "topic occtype:*# comment
.")
                 ("block-comment" "topic occtype:*#( ignored )#.")))
    (destructuring-bind (label text) spec
      (multiple-value-bind (map counter) (accepted (concatenate 'string "boundary:" label) text 31)
        (check (concatenate 'string "boundary:" label ":exact-value-and-counter")
          (and (= 31 counter) (= 1 (length (occurrences map)))
               (item-value-p (first (occurrences map)) "*" *datatype*)))))))
(defun numeric-controls ()
  (dolist (spec '(("+0007" "7" "integer") ("-001" "-1" "integer") ("-00" "0" "integer")
                 (".50" "0.5" "decimal") ("+01.2300" "1.23" "decimal")
                 ("2001-01-01" "2001-01-01" "date")
                 ("2000-01-01T01:00:00+01:00" "2000-01-01T00:00:00Z" "dateTime")
                 ("\"001\"^^<http://www.w3.org/2001/XMLSchema#integer>" "001" "integer")))
    (destructuring-bind (literal value type) spec
      (let ((label (concatenate 'string "numeric:" literal)))
        (multiple-value-bind (map counter) (accepted label (format nil "topic occtype: ~A." literal) 31)
          (assert-occurrence label map value (concatenate 'string "http://www.w3.org/2001/XMLSchema#" type))
          (check (concatenate 'string label ":counter") (= 31 counter)))))))
(defun variant-controls ()
  (let ((bare (accepted "variant:bare" "topic - \"N\" (* @s)." 19))
        (qualified (accepted "variant:qualified" (format nil "topic - \"N\" (~A @s)." *qualified*) 19))
        (string (accepted "variant:string" "topic - \"N\" (\"*\" @s)." 19)))
    (dolist (entry (list (list "bare" bare *datatype*) (list "qualified" qualified *datatype*)
                        (list "string" string (string-datatype))))
      (destructuring-bind (label map datatype) entry
        (let* ((topic (topic-maps.registered-original.tests::local map *doc* "topic"))
               (name (first (topic-names topic))) (variants (topic-name-variants name)) (v (first variants)))
          (check (concatenate 'string "variant:" label ":actual-Variant-value-datatype-parent-and-scope")
            (and (= 1 (length variants)) (equal "*" (variant-value v))
                 (equal datatype (variant-datatype v)) (eq name (variant-parent v))
                 (equal (list (topic-maps.registered-original.tests::local map *doc* "s")) (variant-scope v)))))))
    (check "variant:bare-qualified-CXTM-equal-string-distinct"
      (and (equalp (canonical bare) (canonical qualified)) (not (equalp (canonical bare) (canonical string)))))))
(defun wildcard-controls ()
  (multiple-value-bind (map counter) (accepted "counter:star-only" "topic occtype:*; other:*." 41)
    (check "counter:star-only-no-generated-identifiers"
      (and (= 41 counter) (= 2 (length (occurrences map)))
           (every (lambda (topic)
                    (notany (lambda (iri) (search "#$__" iri)) (topic-item-identifiers topic)))
                  (topic-map-topics map)))))
  (let ((source "? t:*. ?named t:*. ?named u:*. ? t:*."))
    (multiple-value-bind (bare bare-counter) (accepted "counter:interleaved-bare" source 41)
      (multiple-value-bind (qualified qualified-counter)
          (accepted "counter:interleaved-qualified"
            (format nil "? t:~A. ?named t:~A. ?named u:~A. ? t:~A."
                    *qualified* *qualified* *qualified* *qualified*) 41)
        (let* ((iris (loop for topic in (topic-map-topics bare) append (topic-item-identifiers topic)))
               (generated (remove-if-not (lambda (iri) (search "#$__" iri)) iris))
               (expected (mapcar (lambda (suffix) (concatenate 'string *doc* suffix))
                                '("#$__42" "#$__43.named" "#$__44"))))
          (check "counter:only-question-wildcards-increment-and-named-identity-reused"
            (and (= 44 bare-counter qualified-counter)
                 (topic-maps.registered-original.tests::same-set generated expected)
                 (= 4 (length (occurrences bare)))
                 (every (lambda (item) (item-value-p item "*" *datatype*)) (occurrences bare))
                 (equalp (canonical bare) (canonical qualified)))))))))
(defun template-controls ()
  (dolist (spec '(("argument" "def f($v) topic occtype:$v. end f(*)" :occurrence)
                 ("body" "def f() topic occtype:*. end f()" :occurrence)
                 ("nested-argument" "def outer($v) inner($v) end def inner($v) topic occtype:$v. end outer(*)" :occurrence)
                 ("nested-body-argument" "def outer() inner(*) end def inner($v) topic occtype:$v. end outer()" :occurrence)
                 ("variant-argument" "def f($v) topic - \"N\" ($v @s). end f(*)" :variant)
                 ("variant-body" "def f() topic - \"N\" (* @s). end f()" :variant)
                 ("unused-body" "def f() topic occtype:*. end" :empty)))
    (destructuring-bind (label text kind) spec
      (multiple-value-bind (map counter) (accepted (concatenate 'string "template:" label) text 53)
        (check (concatenate 'string "template:" label ":literal-and-counter")
          (and (= 53 counter)
               (ecase kind
                 (:occurrence (and (= 1 (length (occurrences map)))
                                   (item-value-p (first (occurrences map)) "*" *datatype*)))
                 (:variant
                  (let* ((owner (topic-maps.registered-original.tests::local map *doc* "topic"))
                         (name (first (topic-names owner))) (v (first (topic-name-variants name))))
                    (and v (equal "*" (variant-value v)) (equal *datatype* (variant-datatype v))
                         (eq name (variant-parent v)))))
                 (:empty (and (null (topic-map-topics map)) (null (topic-map-associations map)))))))))))
(defun token-controls ()
  (dolist (entry '(("*" ((:ctm-integer "*" 0) (:eof nil 1)))
                   ("*;." ((:ctm-integer "*" 0) (:punctuation #\; 1) (:punctuation #\. 2) (:eof nil 3)))
                   ("? ?named * $v" ((:wildcard nil 0) (:wildcard "named" 2)
                                      (:ctm-integer "*" 9) (:variable "v" 11) (:eof nil 13)))))
    (destructuring-bind (text expected) entry
      (multiple-value-bind (tokens failure) (topic-maps.registered-original.tests::lexical-evidence text "tokens")
        (check (concatenate 'string "tokens:" text) (and (null failure) (equal expected tokens)))))))
