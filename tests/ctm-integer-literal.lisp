    ("missing-separator" "topic
occtype: * extra;." topic-maps.ctm:ctm-rejection :expected-separator 17 2 12)
    ("topic-position" "*." topic-maps.ctm:ctm-rejection :expected-topic-identity 0 1 1)
    ("name-position" "topic - *." topic-maps.ctm:ctm-rejection :expected-name-value 8 1 9)
