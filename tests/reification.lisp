(defpackage #:topic-maps.reification.tests
  (:use #:cl #:topic-maps.tmdm)
  (:import-from #:topic-maps.ctm.tests #:check #:map-state #:read-text #:cxtm #:binary-file)
  (:import-from #:topic-maps.variant.tests #:condition-from)
  (:import-from #:topic-maps.identifier.tests #:fixture #:si #:current #:raw-handles)
  (:export #:run-tests #:reification-checks #:write-reification-report))
(in-package #:topic-maps.reification.tests)
(defvar *last-checks* nil)
(defvar *observations* nil)
(defvar *negatives* nil)
(defun reification-checks () *last-checks*)
(defun reifiables (map) (remove-if-not #'topic-maps.tmdm::reifiable-p (topic-maps.tmdm::map-information-items map)))
(defun state (map &optional handles)
  (list (map-state map) (raw-handles handles)
        (mapcar (lambda (i) (list i (topic-maps.tmdm::%item-reifier i)))
                (remove-if-not #'topic-maps.tmdm::reifiable-p handles))))
(defun invariants (map)
  (and (topic-maps.reference.tests::references-current-p map)
       (topic-maps.tmdm::validate-map-item-identifiers map) (topic-maps.tmdm::validate-map-reification map)))
(defun rejects-atomically (label map handles thunk code)
  (let* ((before (state map handles)) (e (condition-from thunk)))
    (check (concatenate 'string label ":condition")
           (and (typep e 'reification-error) (eq code (reification-error-code e))))
    (check (concatenate 'string label ":original-objects-unchanged") (equal before (state map handles)))))

(defun attachment-tests ()
  (dolist (index '(0 2 3 4 5 6))
    (multiple-value-bind (map items) (fixture)
      (let* ((item (nth index items)) (r (si map "r")) (s (si map "s")))
        (check (format nil "attach:~D:initial-null" index) (and (null (item-reifier item)) (null (topic-reified r))))
        (set-item-reifier item r)
        (check (format nil "attach:~D:both-directions-EQ" index) (and (eq r (item-reifier item)) (eq item (topic-reified r))))
        (check (format nil "attach:~D:idempotent" index) (eq item (set-item-reifier item r)))
        (set-item-reifier item s)
        (check (format nil "attach:~D:assertion-merges-reifier-topics" index)
               (and (eq (canonical-topic r) (canonical-topic s)) (eq (canonical-topic r) (item-reifier item))
                    (eq item (topic-reified s)) (eq map (topic-parent (item-reifier item))) (invariants map)))
        (let ((before (state map items)))
          (check (format nil "attach:~D:CXTM-references-and-purity" index)
                 (and (search "reifier=\"" (cxtm map)) (string= (cxtm map) (cxtm map)) (equal before (state map items)))))
        (set-item-reifier item nil)
        (check (format nil "attach:~D:explicit-clear" index) (and (null (item-reifier item)) (null (topic-reified r)))))))
  (dolist (from '(0 2 3 4 5 6))
    (dolist (to '(0 2 3 4 5 6))
      (unless (= from to)
        (multiple-value-bind (map items) (fixture)
          (let ((r (si map "r")))
            (set-item-reifier (nth from items) r)
            (rejects-atomically (format nil "attach:conflict:~D:~D" from to) map (append items (list r))
              (lambda () (set-item-reifier (nth to items) r)) :reifier-conflict))))))
  (multiple-value-bind (map items) (fixture)
    (rejects-atomically "attach:Topic-is-not-reifiable" map items
      (lambda () (set-item-reifier (second items) (second items))) :not-reifiable)
    (rejects-atomically "attach:wrong-reifier-type" map items
      (lambda () (set-item-reifier (third items) "urn:r")) :invalid-reifier)
    (rejects-atomically "attach:foreign-reifier" map items
      (lambda () (set-item-reifier (third items) (si (make-topic-map) "foreign"))) :foreign-reifier)))

(defun paired-items (kind)
  (let* ((map (make-topic-map)) (a (si map "a")) (b (si map "b")) (type (si map "type")) (theme (si map "theme")))
    (multiple-value-bind (one two)
        (ecase kind
          (topic-name (values (add-name a "N" :type type) (add-name b "N" :type type)))
          (variant (values (add-variant (add-name a "N" :type type) "V" :scope (list theme))
                           (add-variant (add-name b "N" :type type) "V" :scope (list theme))))
          (occurrence (values (add-occurrence a type "O") (add-occurrence b type "O")))
          (association (values (make-association map type (list (list type a))) (make-association map type (list (list type b)))))
          (association-role
           (let ((rel (make-association map type (list (list a type) (list b type)))))
             (values (first (association-roles rel)) (second (association-roles rel))))))
      (values map a b one two))))
(defun item-merge-tests ()
  (dolist (kind '(topic-name variant occurrence association association-role))
    (dolist (reverse '(nil t))
      (multiple-value-bind (map a b one two) (paired-items kind)
        (let ((r (si map "r")) (s (si map "s")))
          (add-item-identifier one "urn:item:one") (add-item-identifier two "urn:item:two")
          (add-item-identifier r "urn:reifier:one") (add-item-identifier s "urn:reifier:two")
          (set-item-reifier one r) (set-item-reifier two s)
          (if reverse (merge-topics b a) (merge-topics a b))
          (check (format nil "merge:~A:~A:item-and-reifier-handles" kind reverse)
                 (and (eq (current one) (current two)) (eq (canonical-topic r) (canonical-topic s))
                      (eq (current one) (topic-reified r)) (eq (item-reifier one) (canonical-topic s))))
          (check (format nil "merge:~A:~A:both-identifier-unions" kind reverse)
                 (and (equal '("urn:item:one" "urn:item:two") (sort (item-identifiers one) #'string<))
                      (equal '("urn:reifier:one" "urn:reifier:two") (sort (item-identifiers r) #'string<)) (invariants map)))
          (let ((third (si map "third")))
            (set-item-reifier one third)
            (check (format nil "merge:~A:~A:reification-through-old-item-handle" kind reverse)
                   (and (eq (canonical-topic third) (item-reifier two)) (eq (current two) (topic-reified r)))))
          (let ((before (state map (list a b one two r s))))
            (check (format nil "merge:~A:~A:all-handles-pure" kind reverse)
                   (and (string= (cxtm map) (cxtm map)) (equal before (state map (list a b one two r s)))))))))))

(defun cascade (&optional collapse)
  (let* ((map (make-topic-map)) (a (si map "a")) (b (si map "b")) (type (si map "type"))
         (r1 (si map "r1")) (s1 (si map "s1")) (r2 (si map "r2")) (s2 (si map "s2"))
         (r3 (si map "r3")) (s3 (si map "s3")) (r4 (si map "r4")) (s4 (si map "s4"))
         (n1 (add-name a "N" :type type)) (n2 (add-name b "N" :type type))
         (o1 (add-occurrence r1 type "O")) (o2 (add-occurrence s1 type "O"))
         (a1 (make-association map type (list (list type r2)))) (a2 (make-association map type (list (list type s2))))
         (p1 (first (association-roles a1))) (p2 (first (association-roles a2)))
         (left (list n1 o1 a1 p1)) (right (list n2 o2 a2 p2))
         (rs (list r1 r2 r3 r4)) (ss (list s1 s2 s3 s4)))
    (loop for x in left for y in right for r in rs for s in ss for index from 1 do
      (add-item-identifier x (format nil "urn:left:~D" index)) (add-item-identifier y (format nil "urn:right:~D" index))
      (set-item-reifier x r) (set-item-reifier y s))
    (when collapse
      (let* ((r (nth (1- collapse) rs)) (s (nth (1- collapse) ss))
             (n (add-name (si map "scope-owner") "Scoped" :type type :scope (list r))))
        (add-variant n "V" :scope (list r s))))
    (values map a b left right rs ss)))
(defun cascade-tests ()
  (dolist (reverse '(nil t))
    (multiple-value-bind (map a b left right rs ss) (cascade)
      (if reverse (merge-topics b a) (merge-topics a b))
      (loop for x in left for y in right for r in rs for s in ss for index from 1 do
        (check (format nil "cascade:~A:level-~D:canonical-objects-and-inverse" reverse index)
               (and (eq (current x) (current y)) (eq (canonical-topic r) (canonical-topic s))
                    (eq (current x) (topic-reified r)) (eq (item-reifier x) (canonical-topic s))
                    (= 2 (length (item-identifiers x))))))
      (check (format nil "cascade:~A:stored-references-and-fixed-point" reverse)
             (and (invariants map) (let ((before (state map (append left right rs ss))))
                                    (normalize-topic-map map) (equal before (state map (append left right rs ss))))))))
  (dolist (level '(1 2 3 4))
    (dolist (route '(:merge :topic-identifier :general-identifier))
      (multiple-value-bind (map a b left right rs ss) (cascade level)
        (add-item-identifier a "urn:trigger")
        (let* ((handles (append (list a b) left right rs ss)) (before (state map handles))
               (e (condition-from (lambda ()
                    (ecase route (:merge (merge-topics a b))
                      (:topic-identifier (add-topic-identifier b :item-identifier "urn:trigger"))
                      (:general-identifier (add-item-identifier b "urn:trigger")))))))
          (check (format nil "cascade:late-scope-collapse:~D:~A:specific" level route)
                 (and (typep e 'variant-error) (eq :variant-scope-collapse (variant-error-code e))))
          (check (format nil "cascade:late-scope-collapse:~D:~A:fully-atomic" level route)
                 (and (equal before (state map handles)) (invariants map)))))))
  (multiple-value-bind (map a b left right rs ss) (cascade)
    (declare (ignore a b))
    (let ((handles (append left right rs ss)))
      (rejects-atomically "conflict:direct-reifier-Topic-merge" map handles
        (lambda () (merge-topics (first rs) (first ss))) :reifier-conflict)
      (rejects-atomically "conflict:already-reifies-another-item" map handles
        (lambda () (set-item-reifier (second left) (first rs))) :reifier-conflict)))
  ;; Setter-induced Topic merging must also preflight the complete scope effect.
  (multiple-value-bind (map items) (fixture)
    (let* ((r (si map "r")) (s (si map "s")) (n (third items))
           (scoped (add-name (second items) "Scoped" :scope (list r))))
      (add-variant scoped "V" :scope (list r s)) (set-item-reifier n r)
      (let* ((before (state map items)) (e (condition-from (lambda () (set-item-reifier n s)))))
        (check "setter:scope-collapse-atomic"
               (and (typep e 'variant-error) (equal before (state map items)) (invariants map)))))))

(defun observe-reification (map)
  (let ((topics (topic-map-topics map)))
    (loop for item in (reifiables map) when (item-reifier item) collect
      (topic-maps.test-foundation::fields "kind" (format nil "~(~A~)" (type-of item))
        "value" (typecase item (topic-name (topic-name-value item)) (variant (variant-value item))
                      (occurrence (occurrence-value item)) (t nil))
        "reifierTopic" (1+ (position (item-reifier item) topics :test #'eq))
        "inverseIsItem" (if (eq item (topic-reified (item-reifier item))) :true :false)
        "itemIsCanonical" (if (eq item (current item)) :true :false)
        "reifierIsCanonical" (if (eq (item-reifier item) (canonical-topic (item-reifier item))) :true :false)))))
(defun original-cases ()
  (setf *observations* nil *negatives* nil)
  (dolist (file '("tm-reifier" "tm-reifier2" "tm-reifier3" "name-reifier" "variant-reifier"
                 "occurrence-reifier" "occurrence-reifier-nested" "occurrence-reifier-nested-nested"
                 "association-reifier" "role-reifier" "role-duplicate-reified-qnames"))
    (let* ((id (format nil "ctm/in/~A.ctm" file))
           (case (first (topic-maps.test-foundation:select-cases topic-maps.ctm.tests::*cxtm-corpus* :id id)))
           (doc (topic-maps.test-foundation:test-case-document-iri case))
           (map (topic-maps.ctm:deserialize-file (topic-maps.test-foundation:test-case-source-pathname case) :document-iri doc :source-name id))
           (before (state map)) (actual (topic-maps.cxtm:canonicalize-octets map :base-locator doc))
           (expected (binary-file (topic-maps.test-foundation:test-case-expected-baseline case))))
      (check (concatenate 'string id ":current-object-identity-and-bidirectional-relations") (invariants map))
      (check (concatenate 'string id ":byte-exact-original-CXTM") (equalp actual expected))
      (check (concatenate 'string id ":serialization-pure") (equal before (state map)))
      (topic-maps.test-foundation:record-result case :cxtm-match)
      (setf (topic-maps.test-foundation:test-case-clauses case) '("CTM 3.3.10" "CTM 3.5" "CTM 3.10-3.13" "TMDM 5.3.4-5.8" "TMDM 6.1-6.7" "CXTM 3.4-3.11"))
      (setf topic-maps.ctm.tests::*cxtm-results* (append topic-maps.ctm.tests::*cxtm-results*
        (list (list :id id :base doc :actual (cxtm map doc) :expected (uiop:read-file-string (topic-maps.test-foundation:test-case-expected-baseline case))
                    :match t :bytes (length actual)))))
      (push (topic-maps.test-foundation::fields "id" id "documentIRI" doc
              "ctmSource" (uiop:read-file-string (topic-maps.test-foundation:test-case-source-pathname case))
              "model" (topic-maps.variant.tests::observe-map map)
              "reifications" (topic-maps.test-foundation::json-array (observe-reification map))) *observations*)
      (format t "~&REIFICATION-CXTM ~A: PASS (~D bytes)~%" id (length actual))))
  (dolist (file '("reifier-collision" "tm-reifier-not-ontop"))
    (let* ((id (format nil "ctm/invalid/~A.ctm" file))
           (case (first (topic-maps.test-foundation:select-cases topic-maps.ctm.tests::*cxtm-corpus* :id id)))
           (source (uiop:read-file-string (topic-maps.test-foundation:test-case-source-pathname case)))
           (e (condition-from (lambda () (topic-maps.ctm:deserialize-file (topic-maps.test-foundation:test-case-source-pathname case)
                  :document-iri (topic-maps.test-foundation:test-case-document-iri case) :source-name id))))
           (code (if (string= file "reifier-collision") :reifier-conflict :topic-map-reifier-position)))
      (check (concatenate 'string id ":specific-reason-and-marker-position")
             (and (eq (type-of e) 'topic-maps.ctm:ctm-rejection) (eq code (topic-maps.ctm:error-code e))
                  (= (position #\~ source :from-end t) (topic-maps.ctm:error-position e))))
      (topic-maps.test-foundation:record-result case :ctm-rejection :diagnostics (list (princ-to-string e)))
      (setf (topic-maps.test-foundation:test-case-clauses case) '("CTM 3.3.10" "CTM 3.5" "TMDM 5.3.4-5.3.5"))
      (push (topic-maps.test-foundation::fields "id" id "code" (string-downcase (symbol-name code))
              "position" (topic-maps.ctm:error-position e) "line" (topic-maps.ctm:error-line e)
              "column" (topic-maps.ctm:error-column e)) *negatives*)))
  (setf *observations* (nreverse *observations*) *negatives* (nreverse *negatives*)))

(defun reader-tests ()
  (dolist (fixture '(("~" :expected-reifier-topic 1) ("a - \"N\" ~ ." :expected-reifier-topic 10)
                     ("a. ~r" :topic-map-reifier-position 3) ("~r ~s" :topic-map-reifier-position 3)))
    (let ((e (topic-maps.ctm.tests::ctm-condition (first fixture))))
      (check (concatenate 'string "reader:reifier-diagnostic:" (first fixture))
             (and (eq (type-of e) 'topic-maps.ctm:ctm-rejection) (eq (second fixture) (topic-maps.ctm:error-code e))
                  (= (third fixture) (topic-maps.ctm:error-position e))))))
  (multiple-value-bind (map counter) (topic-maps.ctm:deserialize-string
       "~?map a - \"N\" ~[-\"R\"] (\"V\"@?theme ~?variant); t:\"O\"~?. rel(role: a ~?role)~?assoc"
       :document-iri "https://example.invalid/reifiers.ctm")
    (check "reader:all-six-bindings-use-shared-wildcard-and-embedded-resolver"
           (and (= 7 counter) (= 6 (length (observe-reification map))) (invariants map))))
  (let* ((map (read-text "a - \"N\"~r1; - \"N\"~r2. rel(role: a ~s1, role: a ~s2)"))
         (n (first (mapcan #'topic-names (topic-map-topics map))))
         (a (first (topic-map-associations map))))
    (check "reader:duplicate-Names-and-Roles-merge-different-reifiers"
           (and (= 1 (length (association-roles a))) (item-reifier n)
                (= 2 (length (topic-item-identifiers (item-reifier n))))
                (= 2 (length (topic-item-identifiers (item-reifier (first (association-roles a)))))) (invariants map)))))

(defun additional-model-tests ()
  (multiple-value-bind (map items) (fixture)
    (let* ((r (si map "scope:r")) (s (si map "scope:s")) (extra (si map "scope:extra"))
           (target (third items)) (name (add-name (second items) "Scoped" :scope (list r s)))
           (v (add-variant name "V" :scope (list r s extra))))
      (add-item-identifier v "urn:scoped-variant")
      (set-item-reifier target r) (set-item-reifier target s)
      (check "scope:Reifier-theme-merge-reduces-cardinality-with-valid-proper-superset"
             (and (= 1 (length (topic-name-scope name))) (= 2 (length (variant-scope v)))
                  (eq (canonical-topic r) (first (topic-name-scope name)))
                  (member (canonical-topic r) (variant-scope v) :test #'eq)
                  (member extra (variant-scope v) :test #'eq)
                  (eq target (topic-reified s)) (equal '("urn:scoped-variant") (item-identifiers v)) (invariants map)))))
  ;; Reifiers can also be ordinary Parent/Type Topics; rescan current owners.
  (let* ((map (make-topic-map)) (owner (si map "owner")) (t1 (si map "t1")) (t2 (si map "t2"))
         (n1 (add-name owner "N" :type t1)) (n2 (add-name owner "N" :type t2)))
    (set-item-reifier n1 owner) (set-item-reifier n2 t2)
    (merge-topics t1 t2)
    (check "alias:reifier-is-also-Parent-and-Type-Topic"
           (and (eq (current n1) (current n2)) (eq (canonical-topic owner) (canonical-topic t2))
                (eq (item-reifier n1) (topic-name-parent n1)) (eq (item-reifier n1) (topic-name-type n1))
                (eq (current n1) (topic-reified owner)) (invariants map))))
  (dolist (kind '(:item-identifier :subject-identifier :subject-locator))
    (multiple-value-bind (map a b left right rs ss) (cascade)
      (declare (ignore a b))
      (add-topic-identifier (first rs) kind "urn:conflict")
      (rejects-atomically (format nil "conflict:Topic-identity-route:~A" kind) map (append left right rs ss)
        (lambda () (add-topic-identifier (first ss) kind "urn:conflict")) :reifier-conflict)))
  (let ((reference nil))
    (dolist (reverse '(nil t))
      (multiple-value-bind (map items) (fixture)
        (dolist (index (if reverse '(6 5 4 3 2 0) '(0 2 3 4 5 6)))
          (set-item-reifier (nth index items) (si map (format nil "reifier:~D" index))))
        (let ((before (state map items)) (out (cxtm map)))
          (unless reference (setf reference out))
          (check (format nil "serialization:construction-order:~A:canonical-numbering-and-purity" reverse)
                 (and (string= out reference) (equal before (state map items)) (invariants map)))))))
  (let* ((map (read-text "%prefix xsd <http://www.w3.org/2001/XMLSchema#> a t:\"01\"^^xsd:integer~r; t: 1~s."))
         (items (mapcan #'topic-occurrences (topic-map-topics map))))
    (check "equality:canonical-value-output-does-not-merge-stored-lexical-values-or-reifiers"
           (and (= 2 (length items)) (not (eq (item-reifier (first items)) (item-reifier (second items))))
                (equal '("01" "1") (mapcar #'occurrence-value items)) (invariants map) (search "<value>1</value>" (cxtm map)))))
  (multiple-value-bind (map items) (fixture)
    (setf (topic-maps.tmdm::%topic-name-reifier (third items)) (si (make-topic-map) "foreign"))
    (let* ((before (state map items)) (e (condition-from (lambda () (cxtm map)))))
      (check "serialization:foreign-Reifier-is-rejected-without-repair"
             (and (typep e 'topic-maps.cxtm:cxtm-error) (eq :invalid-reifier (topic-maps.cxtm:error-code e))
                  (equal before (state map items))))))
  (multiple-value-bind (map items) (fixture)
    (let ((r (si map "r")))
      (setf (topic-maps.tmdm::%topic-name-reifier (third items)) r (topic-maps.tmdm::%occurrence-reifier (fifth items)) r)
      (let* ((before (state map items)) (e (condition-from (lambda () (cxtm map)))))
        (check "serialization:duplicate-Reified-targets-rejected-without-repair"
               (and (typep e 'topic-maps.cxtm:cxtm-error) (eq :reifier-conflict (topic-maps.cxtm:error-code e))
                    (equal before (state map items))))))))

(defun run-tests ()
  (topic-maps.identifier.tests:run-tests)
  (let ((topic-maps.ctm.tests::*checks* nil))
    (attachment-tests) (item-merge-tests) (cascade-tests) (reader-tests) (additional-model-tests) (original-cases)
    (check "reification:only-thirteen-imported-contract-transitions"
           (equal '(:pass 106 :fail 2 :unsupported 0 :not-run 165)
                  (getf (topic-maps.test-foundation:summarize-corpus topic-maps.ctm.tests::*cxtm-corpus*) :statuses)))
    (setf *last-checks* (nreverse topic-maps.ctm.tests::*checks*))
    (format t "~&REIFICATION-PASS: ~D checks; 11 original byte-exact comparisons, 2 specific rejections; 106 PASS, 2 known FAIL, 165 NOT-RUN.~%" (length *last-checks*)) t))
(defun write-reification-report (path)
  (with-open-file (out path :direction :output :if-exists :supersede :if-does-not-exist :create)
    (topic-maps.test-foundation::emit-json-value
      (topic-maps.test-foundation::fields "kind" "reification-evidence" "passed" (length *last-checks*) "failed" 0
        "checks" (topic-maps.test-foundation::json-array *last-checks*)
        "cases" (topic-maps.test-foundation::json-array *observations*)
        "negativeCases" (topic-maps.test-foundation::json-array *negatives*)) out)
    (terpri out)))
