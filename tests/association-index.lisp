(in-package #:topic-maps.association-index.tests)

;;; Which Associations merge next, and the results that must not change while the search for them changes.
;;; The expected CXTM of every case, the facts of every API scenario and the class and code of every rejection
;;; were recorded from the unchanged implementation at 6162ed68 (RECORD-EXPECTED) before NEXT-ASSOCIATION-MERGE
;;; existed; they are not derived from the implementation under test. SCAN-NEXT-ASSOCIATION-MERGE is the 6162ed68
;;; search, kept as the fallback and used here as the oracle.

(defvar *last-checks* nil)
(defun association-index-checks () *last-checks*)
(defparameter +document+ "https://example.invalid/a/doc.ctm")
(defvar *fixture-directory* nil)
(defun fixture-directory ()
  (or *fixture-directory* (asdf:system-relative-pathname "topic-maps" "tests/fixtures/association-index/")))
(defun read-case (text) (topic-maps.ctm:deserialize-string text :document-iri +document+ :source-name "association-index"))
(defun pick (random sequence) (elt sequence (random (length sequence) random)))
(defun ii (name) (format nil "~A#~A" +document+ name))

;;; Documents whose result must not change

(defun same-type-document (associations duplicate-every)
  "ASSOCIATIONS Associations of one type with distinct players; every DUPLICATE-EVERYth is stated twice."
  (with-output-to-string (s)
    (dotimes (i associations)
      (format s "t(r: p~D, q: o~D)~%" i (mod i 7))
      (when (and (plusp duplicate-every) (zerop (mod i duplicate-every))) (format s "t(q: o~D, r: p~D)~%" (mod i 7) i)))))

