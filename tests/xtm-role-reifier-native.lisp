(in-package #:topic-maps.xtm.tests)

(defvar *role-reifier-native* nil)
(defun rrr-current-p (map)
  (and (arr-current-p map)
    (every (lambda (role) (let ((r (item-reifier role)))
      (or (null r) (and (eq r (canonical-topic r)) (eq map (topic-parent r)) (eq role (topic-reified r)))))) (as-roles map))))
(defun rrr-model (map)
  (mm-fields "existingModel" (arr-model map) "canonicalRoleReifierInverseEQ" (if (rrr-current-p map) :true :false)
    "roleReifiers" (coerce (loop for a in (topic-map-associations map) for ai from 1 append
      (loop for role in (association-roles a) collect
        (mm-fields "parentAssociationOrdinal" ai "roleItemIdentifiers" (coerce (item-identifiers role) 'vector)
          "reifierItemIdentifiers" (coerce (when (item-reifier role) (item-identifiers (item-reifier role))) 'vector)
          "inverseReifiedEQ" (if (or (null (item-reifier role)) (eq role (topic-reified (item-reifier role)))) :true :false)))) 'vector)))
(defun rrr-native-tests ()
  ;; Public TMDM API only. Run before any Reader edit and again through ASDF.
  (setf *role-reifier-native* nil)
  (let* ((map (make-topic-map)) (type (intern-topic map :item-identifier "urn:type"))
         (rt (intern-topic map :item-identifier "urn:rt")) (p (intern-topic map :item-identifier "urn:p"))
         (a (make-association map type (list (list rt p) (list rt p))))
         (role (first (association-roles a))) (r (intern-topic map :item-identifier "urn:r"))
         (u (intern-topic map :item-identifier "urn:u")))
    (add-item-identifier a "urn:a") (add-item-identifier role "urn:role")
    (check "role-reifier-native:single-and-equal-Roles:assignment-inverse"
      (and (= 1 (length (association-roles a))) (eq role (set-item-reifier role r))
        (eq r (item-reifier role)) (eq role (topic-reified r)) (rrr-current-p map)))
    (check "role-reifier-native:same-Role-same-Reifier:idempotent"
      (let ((before (ik-state map))) (set-item-reifier role r) (equal before (ik-state map))))
    (set-item-reifier role u)
    (check "role-reifier-native:same-Role-different-Reifiers:Topic-merge-II-and-handles"
      (and (eq (canonical-topic r) (canonical-topic u))
        (same-identifiers-p '("urn:r" "urn:u") (item-identifiers (item-reifier role)))
        (eq (canonical-association-role role) (topic-reified r)) (eq (canonical-association-role role) (topic-reified u))
        (equal '("urn:a") (item-identifiers (canonical-association a)))
        (equal '("urn:role") (item-identifiers (canonical-association-role role))) (rrr-current-p map)))
    (push (mm-fields "label" "equal-Roles-and-Reifiers" "kind" "native-TMDM-probe-not-original-contract" "model" (rrr-model map)) *role-reifier-native*))
  (dolist (kind '(:subject-identifier :subject-locator :item-identifier))
    (dolist (shared-parent '(nil t))
      (let* ((map (make-topic-map)) (type (intern-topic map :item-identifier "urn:type"))
             (rt (intern-topic map :item-identifier "urn:rt")) (s (intern-topic map :item-identifier "urn:scope"))
             (p (intern-topic map :item-identifier "urn:p")) (q (intern-topic map :item-identifier "urn:q"))
             (a (make-association map type (if shared-parent (list (list rt p) (list rt q)) (list (list rt p))) :scope (list s)))
             (b (if shared-parent a (make-association map type (list (list rt q)) :scope (list s))))
             (ra (first (association-roles a))) (rb (if shared-parent (second (association-roles a)) (first (association-roles b))))
             (r (intern-topic map :item-identifier "urn:r")) (u (intern-topic map :item-identifier "urn:u"))
             (ar (intern-topic map :item-identifier "urn:ar")) (au (intern-topic map :item-identifier "urn:au"))
             (label (format nil "~A:~A" kind (if shared-parent "same-parent" "different-parents"))))
        (add-item-identifier a "urn:a") (add-item-identifier b "urn:b")
        (add-item-identifier ra "urn:ra") (add-item-identifier rb "urn:rb")
        (set-item-reifier ra r) (set-item-reifier rb u)
        (set-item-reifier a ar) (unless shared-parent (set-item-reifier b au))
        (add-topic-identifier p kind "urn:common") (add-topic-identifier q kind "urn:common")
        (let ((current (canonical-association a)) (role (canonical-association-role ra)))
          (check (format nil "role-reifier-native:~A:native-merge-Role-Association-Topic-handles-and-II" label)
            (and (= 1 (length (topic-map-associations map))) (= 1 (length (as-roles map)))
              (eq current (canonical-association b)) (eq role (canonical-association-role rb))
              (not (eq ra role)) (not (eq rb role)) (eq current (association-role-parent role))
              (eq rt (association-role-type role)) (eq (canonical-topic p) (association-role-player role))
              (eq (canonical-topic p) (canonical-topic q)) (eq map (association-parent current))
              (eq type (association-type current)) (equal (list s) (association-scope current))
              (same-identifiers-p '("urn:a" "urn:b") (item-identifiers current))
              (same-identifiers-p '("urn:ra" "urn:rb") (item-identifiers role))
              (eq (canonical-topic r) (canonical-topic u)) (eq role (topic-reified r)) (eq role (topic-reified u))
              (same-identifiers-p '("urn:r" "urn:u") (item-identifiers (item-reifier role)))
              (eq current (topic-reified ar)) (or shared-parent (eq current (topic-reified au)))
              (equal (list role) (topic-roles-played (canonical-topic p))) (rrr-current-p map))))
        (push (mm-fields "label" label "kind" "native-TMDM-probe-not-original-contract" "model" (rrr-model map)
          "allOldHandlesResolveEQ" :true) *role-reifier-native*))))
  (let* ((map (make-topic-map)) (type (intern-topic map :item-identifier "urn:type"))
         (other (intern-topic map :item-identifier "urn:other-type"))
         (rt (intern-topic map :item-identifier "urn:rt")) (p (intern-topic map :item-identifier "urn:p"))
         (a (make-association map type (list (list rt p)))) (b (make-association map other (list (list rt p))))
         (ra (first (association-roles a))) (rb (first (association-roles b)))
         (r (intern-topic map :item-identifier "urn:r")) (u (intern-topic map :item-identifier "urn:u"))
         (o (add-occurrence p type "V")))
    (set-item-reifier ra r) (set-item-reifier rb u)
    (dolist (row (list (list "same-signature-different-parent-original-cause" (lambda () (set-item-reifier rb r)))
                      (list "Role-versus-Association" (lambda () (set-item-reifier a r)))
                      (list "Role-versus-Occurrence" (lambda () (set-item-reifier o r)))
                      (list "Role-versus-Map" (lambda () (set-item-reifier map r)))
                      (list "late-Reifier-Topic-merge" (lambda () (merge-topics r u)))))
      (let* ((before (ik-state map)) (c (condition-from (second row))))
        (check (format nil "role-reifier-native:~A:exact-atomic-conflict" (first row))
          (and (eq (type-of c) 'reification-error) (eq :reifier-conflict (reification-error-code c))
            (equal before (ik-state map)) (= 2 (length (topic-map-associations map)))
            (not (eq a b)) (not (eq ra rb)) (eq rt (association-role-type rb)) (eq p (association-role-player rb))
            (eq ra (topic-reified r)) (eq rb (topic-reified u)) (rrr-current-p map)))
        (push (mm-fields "label" (first row) "kind" "native-TMDM-probe-not-original-contract"
          "condition" (mm-condition c) "nativeOperationUnchanged" :true "differentParentsPreserved" :true) *role-reifier-native*)))
    (add-item-identifier ra "urn:role")
    (let* ((before (ik-state map)) (c (condition-from (lambda () (intern-topic map :item-identifier "urn:role")))))
      (check "role-reifier-native:Role-II-not-Reifier-II:atomic-conflict"
        (and (typep c 'item-identifier-error) (eq :duplicate-item-identifier (item-identifier-error-code c)) (equal before (ik-state map))))
      (push (mm-fields "label" "own-II-not-Reifier-II" "kind" "native-TMDM-probe-not-original-contract" "condition" (mm-condition c)
        "nativeOperationUnchanged" :true) *role-reifier-native*)))
  (setf *role-reifier-native* (nreverse *role-reifier-native*)))
