(in-package #:topic-maps.ctm.tests)

(defun graph-components (nodes edges)
  ;; Independent reachability oracle, without using the model's identity logic.
  (let ((remaining (copy-list nodes)) (components nil))
    (loop while remaining do
      (let ((component (list (pop remaining))) (changed t))
        (loop while changed do
          (setf changed nil)
          (dolist (edge edges)
            (when (some (lambda (node) (member node component)) edge)
              (dolist (node edge)
                (unless (member node component)
                  (push node component) (setf remaining (remove node remaining) changed t))))))
        (push component components)))
    components))

(defun run-merging-graph-checks ()
  ;; Every undirected graph on four topics (64), in both edge orders.
  ;; Shared edge SIs encode its connections; each Topic starts with one Name.
  (let ((possible '((0 1) (0 2) (0 3) (1 2) (1 3) (2 3))))
    (dotimes (mask 64)
      (let* ((edges (loop for edge in possible for bit from 0 when (logbitp bit mask) collect edge))
             (components (graph-components '(0 1 2 3) edges)))
        (dolist (reverse-order '(nil t))
          (let* ((map (topic-maps.tmdm:make-topic-map))
                 (topics (loop for i below 4 collect
                           (topic-maps.tmdm:intern-topic map :item-identifier (format nil "urn:node:~D" i))))
                 (names (mapcar (lambda (topic) (topic-maps.tmdm:add-default-name topic "Shared")) topics))
                 (order (if reverse-order (reverse edges) edges))
                 (label (format nil "graph:~D:~S:" mask reverse-order)))
            (dolist (edge order)
              (let ((locator (format nil "urn:edge:~D:~D" (first edge) (second edge))))
                (dolist (node edge)
                  (topic-maps.tmdm:add-topic-identifier (nth node topics) :subject-identifier locator))))
            (check (concatenate 'string label "component-count")
                   (= (1+ (length components)) (length (topic-map-topics map))))
            (check (concatenate 'string label "component-identities")
                   (every (lambda (component)
                            (let ((root (topic-maps.tmdm:canonical-topic (nth (first component) topics))))
                              (and (every (lambda (node) (eq root (topic-maps.tmdm:canonical-topic (nth node topics)))) component)
                                   (same-locator-set-p (topic-item-identifiers root)
                                                      (mapcar (lambda (node) (format nil "urn:node:~D" node)) component)))))
                          components))
            (check (concatenate 'string label "name-coalescence-and-handles")
                   (every (lambda (component)
                            (let* ((root (topic-maps.tmdm:canonical-topic (nth (first component) topics)))
                                   (name (first (topic-names root))))
                              (and (= 1 (length (topic-names root)))
                                   (every (lambda (node) (eq name (topic-maps.tmdm:canonical-topic-name (nth node names)))) component))))
                          components))
            (check (concatenate 'string label "raw-reference-integrity") (raw-reference-invariants map))))))))
